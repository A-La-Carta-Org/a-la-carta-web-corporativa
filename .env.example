# Variables de entorno de la web corporativa de alaCarta.
# Las PUBLIC_* se hornean en el bundle del cliente durante el build (son públicas).
# Copia este archivo a .env para desarrollo local. No subas .env al repositorio.

# URL pública del sitio (canonical, sitemap, Open Graph)
SITE_URL=https://alacarta.com

# Endpoint que recibe los formularios (demo y contacto) como JSON por POST.
# Vacío = los formularios abren el correo con la solicitud ya escrita y llevan a /gracias.
# Contrato (campos, envío sin JS, redirección) en docs/DESPLIEGUE.md §6.
PUBLIC_FORM_ENDPOINT=

# Analítica (opcional). Vacío = no se carga nada.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_ID=
