---
/**
 * Plantilla de sector (docs/auditoria/12 §2): hero con visual propio, problemas → soluciones,
 * «un día en tu local», configuración recomendada con su precio orientativo (quote.ts) y enlace
 * al configurador precargado, la demo que mejor encaja, FAQ, otros sectores y cierre.
 * Una sola isla por página (la demo), con `client:visible`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import FaqSection from '@/components/blocks/FaqSection.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import SectorGrid from '@/components/blocks/SectorGrid.astro';
import SectorHeroVisual from '@/components/blocks/SectorHeroVisual.astro';
import DayTimeline from '@/components/blocks/DayTimeline.astro';
import RecommendedSetup from '@/components/blocks/RecommendedSetup.astro';
import DemoBlock from '@/components/blocks/DemoBlock.astro';
import { sectors, sectorPath, type Sector } from '@/data/sectors';
import { fromLabel } from '@/data/pricing';
import { sectorPresets } from '@/lib/quote';
import { breadcrumbJsonLd, faqJsonLd } from '@/lib/seo';
import { ctaHref } from '@/lib/cta';

export function getStaticPaths() {
  return sectors.map((s) => ({ params: { slug: s.slug }, props: { sector: s } }));
}

interface Props {
  sector: Sector;
}
const { sector: s } = Astro.props;
const path = sectorPath(s.slug);
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Sectores', path: '/sectores' },
  { name: s.name, path },
];
const origen = `sector-${s.slug}`;
const isGroup = s.slug === 'grupos-y-cadenas';
const yourPlace = isGroup ? 'tu grupo' : 'tu local';
const configHref = ctaHref({
  to: 'precios',
  sector: s.slug,
  origen: `${origen}-config`,
  hash: 'monta',
});
// Otros sectores: los tres siguientes en la lista, dando la vuelta
const idx = sectors.findIndex((x) => x.slug === s.slug);
const others = [1, 2, 3].map((n) => sectors[(idx + n) % sectors.length]!.slug);
const demoTry = {
  simulador: 'Toma una comanda y mira cómo llega a cocina y a caja.',
  carta: 'Abre la carta de ejemplo como la verá tu cliente.',
  llamada: 'Mira cómo se atiende una llamada de ejemplo.',
  canales: 'Cambia un precio y míralo cambiar en todos los canales.',
  calculadora: 'Haz la cuenta de lo que se te va en comisiones.',
  comprobador: 'Comprueba si te sirve el equipo que ya tienes.',
}[s.demo.key];
---

<BaseLayout
  title={s.seoTitle}
  description={s.description}
  path={path}
  jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(s.faqs)]}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow={`Software para ${s.name.toLowerCase()}`}
    eyebrowIcon={s.icon}
    title={s.title}
    text={s.intro}
    primary={{
      label: 'Solicitar demo',
      href: ctaHref({ to: 'demo', sector: s.slug, origen: `${origen}-hero` }),
    }}
    secondary={{ label: 'Ver mi configuración', href: '#configuracion' }}
    note={`Sin permanencia · ${fromLabel}`}
  >
    <SectorHeroVisual hero={s.hero} />
  </PageHero>

  <section class="section has-rule">
    <div class="container">
      <SectionHeader
        eyebrow="Lo que suele fallar"
        title={`Los problemas de ${s.name.toLowerCase()}, y cómo se resuelven`}
      />
      <div class="sec-pairs">
        {s.pains.map((p, i) => (
          <div class="sec-pair">
            <div class="sec-pair__pain">
              <span class="eyebrow">Problema</span>
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </div>
            <div class="sec-pair__answer">
              <span class="eyebrow">Con alaCarta</span>
              <h3>{s.answers[i]!.title}</h3>
              <p class="muted">{s.answers[i]!.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section is-soft" id="un-dia">
    <div class="container">
      <SectionHeader
        eyebrow={`Un día en ${yourPlace}`}
        title="De la apertura al cierre, qué pieza trabaja en cada momento"
        text="Un día normal, contado hora a hora. Lo marcado «en camino» todavía no está disponible: te lo decimos para que sepas qué tendrás hoy y qué vendrá."
      />
      <DayTimeline items={s.day} />
    </div>
  </section>

  <section class="section" id="configuracion">
    <div class="container">
      <SectionHeader
        eyebrow="Configuración recomendada"
        title={`Lo que suele llevar ${s.singular}`}
        text="Un punto de partida, no una obligación. Ábrelo en el configurador y quita o añade lo que quieras: el precio cambia al momento."
      />
      <RecommendedSetup
        config={sectorPresets[s.slug] ?? {}}
        kits={s.recommended.kits}
        later={s.recommended.later}
        text={s.recommended.text}
        href={configHref}
        label={`${s.name} · de partida`}
      />
    </div>
  </section>

  <DemoBlock demo={s.demo.key} title={s.demo.title} text={s.demo.text} origen={`${origen}-demo`} />

  <FaqSection items={s.faqs} title={`Preguntas de ${s.name.toLowerCase()}`} />

  <section class="section is-sm has-rule">
    <div class="container">
      <SectionHeader eyebrow="Otros sectores" title="También configuramos la plataforma para" />
      <SectorGrid only={others} />
    </div>
  </section>

  <CtaBand
    title={`Vamos a ver ${yourPlace}`}
    sector={s.slug}
    origen={origen}
    tryLink={{ label: 'Probar la demo', href: '#pruebalo', text: demoTry }}
    calcLink={{
      label: 'Monta tu alaCarta',
      href: ctaHref({ to: 'precios', sector: s.slug, origen, hash: 'monta' }),
      text: 'Parte de la configuración de este sector y ajústala con tus números.',
    }}
  />
</BaseLayout>

<style>
  .sec-pairs {
    display: grid;
    gap: var(--space-4);
  }
  .sec-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .sec-pair__pain,
  .sec-pair__answer {
    padding: var(--space-8);
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .sec-pair__pain {
    background: var(--color-bg-soft);
  }
  .sec-pair__answer {
    border-left: 1px solid var(--color-border);
  }
  .sec-pair h3 {
    font-size: var(--text-lg);
  }
  .sec-pair p {
    font-size: var(--text-sm);
  }
  @media (max-width: 720px) {
    .sec-pair {
      grid-template-columns: 1fr;
    }
    .sec-pair__answer {
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
