---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ctaHref } from '@/lib/cta';
import PageHero from '@/components/blocks/PageHero.astro';
import FaqList from '@/components/blocks/FaqList.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { faqGroups, type FaqGroup } from '@/data/faqs';
import { getFamily } from '@/data/solutions';
import { breadcrumbJsonLd, faqJsonLd } from '@/lib/seo';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Recursos', path: '/recursos' },
  { name: 'Preguntas frecuentes', path: '/recursos/preguntas-frecuentes' },
];
const all = faqGroups.flatMap((g) => g.items);
/* El icono de cada grupo: el de su familia; precios y empresa, el suyo */
const groupIcon = (id: FaqGroup['id']): IconName =>
  id === 'precios' ? 'receipt' : id === 'empresa' ? 'building' : getFamily(id).icon;
---

<BaseLayout
  title="Preguntas frecuentes sobre alaCarta"
  description="Respuestas directas sobre alaCarta: sala y cocina, canales propios, gestión y equipo, equipamiento, precios sin comisiones y en qué punto estamos."
  path="/recursos/preguntas-frecuentes"
  jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(all)]}
>
  <PageHero
    variant="compact"
    breadcrumbs={crumbs}
    eyebrow="Preguntas frecuentes"
    title="Lo que suelen preguntarnos"
    text="Si tu duda no está aquí, escríbenos. Te contestamos en menos de un día laborable."
  />

  <section class="section is-sm">
    <div class="container faq-page">
      <nav class="faq-page__nav" aria-label="Secciones">
        <ul role="list">
          {faqGroups.map((g) => (
            <li>
              <a href={`#${g.id}`}>
                <Icon name={groupIcon(g.id)} size={16} />
                {g.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="faq-page__groups">
        {faqGroups.map((g) => (
          <section id={g.id} class="faq-page__group" aria-labelledby={`${g.id}-title`}>
            <header class="faq-page__group-head">
              <span class="faq-page__icon">
                <Icon name={groupIcon(g.id)} size={20} />
              </span>
              <div>
                <h2 id={`${g.id}-title`}>{g.title}</h2>
                {g.text && <p class="muted">{g.text}</p>}
              </div>
            </header>
            <FaqList items={g.items} />
          </section>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="¿Otra pregunta?"
    text="Cuéntanos tu caso y te respondemos con detalle, sin guion comercial."
    origen="faq-cierre"
    extraLink={{
      label: 'O escríbenos tu pregunta',
      href: ctaHref({ to: 'contacto', origen: 'faq-cierre' }),
    }}
  />
</BaseLayout>

<style>
  .faq-page {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--space-16);
    align-items: start;
  }
  .faq-page__nav {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
  }
  .faq-page__nav ul {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .faq-page__nav a {
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .faq-page__nav a:hover {
    color: var(--color-text-strong);
  }
  .faq-page__groups {
    display: grid;
    gap: var(--space-16);
  }
  .faq-page__group {
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .faq-page__group-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-6);
  }
  .faq-page__group-head p {
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }
  .faq-page__icon {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-strong);
  }
  .faq-page__group h2 {
    font-size: var(--text-2xl);
  }
  @media (max-width: 1024px) {
    .faq-page {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .faq-page__nav {
      position: static;
    }
    .faq-page__nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-5);
    }
  }
</style>
