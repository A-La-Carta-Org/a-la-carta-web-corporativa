---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import { getCollection } from 'astro:content';
import { breadcrumbJsonLd } from '@/lib/seo';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Recursos', path: '/recursos' },
  { name: 'Guías', path: '/recursos/guias' },
];
const guias = (await getCollection('guias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Guías para hostelería: TPV, VeriFactu, carta QR"
  description="Guías prácticas y sin relleno para negocios de hostelería: cómo elegir un TPV, qué exige VeriFactu y cómo hacer una carta digital QR que funcione."
  path="/recursos/guias"
  jsonLd={breadcrumbJsonLd(crumbs)}
>
  <PageHero
    variant="compact"
    breadcrumbs={crumbs}
    eyebrow="Guías"
    title="Pocas guías, bien hechas"
    text="Escribimos sobre lo que sabemos y cuando tenemos algo útil que decir. Cada guía indica su fecha; las normativas se actualizan cuando cambian."
  />

  <section class="section is-sm">
    <div class="container">
      <ul role="list" class="guides">
        {guias.map((g) => (
          <li>
            <a href={`/recursos/guias/${g.id}`} class="guide">
              <span class="guide__meta muted">
                <time datetime={g.data.publishedAt.toISOString()}>{fmt(g.data.publishedAt)}</time> ·{' '}
                {g.data.readingMinutes} min
              </span>
              <h2>{g.data.title}</h2>
              <p class="muted">{g.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .guides {
    border-top: 1px solid var(--color-border);
    max-width: 52rem;
  }
  .guide {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .guide:hover {
    text-decoration: none;
  }
  .guide:hover h2 {
    text-decoration: underline;
  }
  .guide__meta {
    font-size: var(--text-xs);
  }
  .guide h2 {
    font-size: var(--text-2xl);
  }
  .guide p {
    font-size: var(--text-base);
  }
</style>
