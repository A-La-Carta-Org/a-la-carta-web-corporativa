---
/**
 * Contacto (docs/auditoria/11 §6): lo que **no** es venta — soporte, gestorías, partners y
 * prensa. Quien quiere contratar va a la demo (tarjeta-enlace dentro del formulario) o pide que le
 * llamemos. Bloque para gestorías y asesorías (canal prescriptor). Sin teléfono: está pendiente.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/islands/ContactForm.vue';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import { iconPaths } from '@/components/ui/icons';
import { ctaHref } from '@/lib/cta';
import { contactMotives } from '@/lib/lead';
import { CONTACT_EMAIL, SUPPORT_EMAIL, REPLY_HOURS } from '@/data/site';
import { breadcrumbJsonLd } from '@/lib/seo';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Contacto', path: '/contacto' },
];
const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto alaCarta',
  url: 'https://alacarta.com/contacto',
};

const icons = Object.fromEntries(
  [...contactMotives.map((m) => m.icon), 'store'].map((k) => [
    k,
    iconPaths[k as keyof typeof iconPaths],
  ])
);
const salesHref = ctaHref({ to: 'demo', origen: 'contacto-motivo' });

const gestoria = [
  {
    title: 'Con tu propio acceso',
    text: 'Tu cliente te da un usuario y entras a lo que necesitas, sin pedirle papeles ni esperar al final del trimestre.',
  },
  {
    title: 'Ventas y cierres, hoy',
    text: 'Desde el backoffice: ventas, cierres diarios y productos en CSV o Excel. Compras, facturas de proveedor e IVA irán en el ERP, que está en camino.',
  },
  {
    title: 'El mes del equipo, cerrado',
    text: 'Desde Equipo y RRHH: horas, extras y ausencias del mes listas para la nómina. La nómina la sigues calculando tú.',
  },
];
---

<BaseLayout
  title="Contacto"
  description={`Escribe a alaCarta: soporte, gestorías y asesorías, partners y prensa. Para contratar, pide una demo. Respondemos en menos de ${REPLY_HOURS} horas laborables.`}
  path="/contacto"
  jsonLd={[breadcrumbJsonLd(crumbs), contactJsonLd]}
>
  <section class="contact" id="formulario">
    <div class="container contact__inner">
      <div class="contact__copy">
        <span class="eyebrow">Contacto</span>
        <h1>Hablemos</h1>
        <p class="lead">
          Para soporte, gestorías, partners, prensa o cualquier otra cosa. Si lo que quieres es ver
          alaCarta o saber cuánto te costaría, el camino corto es la{' '}
          <a href={ctaHref({ to: 'demo', origen: 'contacto' })}>demo</a>.
        </p>
        <dl class="contact__channels">
          <div>
            <dt>Correo general</dt>
            <dd>
              <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            </dd>
          </div>
          <div>
            <dt>Soporte a clientes</dt>
            <dd>
              <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
            </dd>
          </div>
          <div>
            <dt>Cuándo contestamos</dt>
            <dd>Lunes a viernes, en menos de {REPLY_HOURS} horas laborables.</dd>
          </div>
        </dl>
        <a href={ctaHref({ to: 'llamada', origen: 'contacto' })} class="contact__call">
          <Icon name="ai-call" size={18} />
          <span>
            <strong>¿Prefieres hablar?</strong>
            <span class="muted">Déjanos tu teléfono y te llamamos.</span>
          </span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <div class="contact__form card">
        <ContactForm client:load icons={icons} salesHref={salesHref} />
      </div>
    </div>
  </section>

  <section class="section is-soft" aria-labelledby="gestorias">
    <div class="container">
      <div class="contact__band">
        <div class="section-header">
          <span class="eyebrow">Gestorías y asesorías</span>
          <h2 id="gestorias">Si llevas restaurantes, alaCarta te ahorra papeles</h2>
          <p>
            Tus clientes de hostelería tienen las ventas, el equipo y, pronto, las compras en el
            mismo sitio. Tú entras con tu usuario y te llevas lo que necesitas.
          </p>
          <a
            href={`${ctaHref({ to: 'contacto', motivo: 'gestoria', origen: 'contacto-gestorias' })}#formulario`}
            class="link-arrow"
          >
            Escríbenos como gestoría
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <div class="contact__cols">
          {gestoria.map((g) => (
            <div class="column">
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="¿Lo que buscas es ver alaCarta?"
    text="En una videollamada corta te enseñamos la plataforma con un caso parecido al tuyo. O pruébalo ahora, sin datos ni registro."
    origen="contacto-cierre"
  />
</BaseLayout>

<style>
  .contact {
    padding-block: clamp(2rem, 1.5rem + 3vw, 4.5rem) var(--section-y);
    scroll-margin-top: var(--header-h);
  }
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-16);
    align-items: start;
  }
  .contact__copy {
    display: grid;
    gap: var(--space-6);
  }
  .contact__copy h1 {
    font-size: var(--text-4xl);
  }
  .contact__copy .lead a {
    text-decoration: underline;
    color: var(--color-text-strong);
  }
  .contact__channels {
    display: grid;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
  }
  .contact__channels div {
    display: grid;
    gap: 2px;
  }
  .contact__channels dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }
  .contact__channels dd {
    font-size: var(--text-base);
    color: var(--color-text-strong);
  }
  .contact__call {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-strong);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .contact__call:hover {
    border-color: var(--color-ink);
    text-decoration: none;
  }
  .contact__call > span {
    display: grid;
    gap: 2px;
    flex: 1 1 auto;
    font-size: var(--text-sm);
  }
  .contact__call strong {
    font-family: var(--font-display);
    font-size: var(--text-base);
  }
  .contact__form {
    padding: var(--space-8);
  }
  .contact__band {
    display: grid;
    gap: var(--space-12);
  }
  .contact__band .section-header {
    margin-bottom: 0;
  }
  .contact__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  @media (max-width: 1024px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
  @media (max-width: 720px) {
    .contact__cols {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .contact__form {
      padding: var(--space-5);
    }
  }
</style>
