---
/**
 * Plantilla de producto (docs/auditoria/04 §4). Una sola plantilla para los 13 productos, con
 * bloques que se activan u omiten según los datos de `solutions.ts`:
 *
 *  1. Hero (maqueta, o placa QR escaneable si `heroVariant: 'demo'`) + mini-tarjeta de precio
 *  2. Lo que dejas de hacer (`replaces` + `outcome`)
 *  3. Qué hace (`features` o `featureGroups`)
 *  4. Pruébalo (si la demo del producto ya está publicada, ver `demoCta()` en src/lib/cta.ts):
 *     la carta QR, la llamada de ejemplo (D4) y «un cambio, todos los canales» (D2) se juegan aquí
 *     mismo (`#pruebalo`); el simulador (D1) es una tarjeta que abre /demo en su pantalla
 *  5. Conectado con el resto: diagrama radial (`connections`)
 *  6. Datos del sector (`proofPoints`)
 *  7. Equipamiento recomendado (`hardware`)
 *  8. Para quién (`forWho`, sectores que lo usan, momentos y guías relacionadas)
 *  9. Precio (`solutionPricing()` de src/data/pricing.ts)
 * 10. Preguntas frecuentes (≥ 4)
 * 11. Cierre con tres salidas: probar o configurar, calcular, demo o «te llamamos»
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import FeatureColumns from '@/components/blocks/FeatureColumns.astro';
import FaqSection from '@/components/blocks/FaqSection.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import SectorGrid from '@/components/blocks/SectorGrid.astro';
import ConnectionsDiagram from '@/components/blocks/ConnectionsDiagram.astro';
import ReplacesTicket from '@/components/blocks/ReplacesTicket.astro';
import HardwareCards from '@/components/blocks/HardwareCards.astro';
import ProofPoints from '@/components/blocks/ProofPoints.astro';
import PriceMini from '@/components/blocks/PriceMini.astro';
import PriceBand from '@/components/blocks/PriceBand.astro';
import Mockup from '@/components/mockups/Mockup.astro';
import QrPlate from '@/components/ui/QrPlate.astro';
import Icon from '@/components/ui/Icon.astro';
import QrCode from '@/components/ui/QrCode.astro';
import DemoCarta from '@/components/islands/DemoCarta.vue';
import CallDemo from '@/components/islands/CallDemo.vue';
import ChannelsDemo from '@/components/islands/ChannelsDemo.vue';
import { DEMO_CARTA_URL } from '@/data/navigation';
import {
  solutions,
  solutionPath,
  getFamily,
  type Solution,
  type SolutionSlug,
} from '@/data/solutions';
import { sectors } from '@/data/sectors';
import { moments, momentPath } from '@/data/moments';
import { solutionPricing } from '@/data/pricing';
import { breadcrumbJsonLd, softwareJsonLd, serviceJsonLd, faqJsonLd } from '@/lib/seo';
import { ctaHref, demoCta, demoShortTexts } from '@/lib/cta';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { solution: s } }));
}

interface Props {
  solution: Solution;
}
const { solution: s } = Astro.props;
const path = solutionPath(s.slug);
const family = getFamily(s.family);
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Soluciones', path: '/soluciones' },
  { name: s.navLabel, path },
];
const origen = `sol-${s.slug}`;
const pricing = solutionPricing(s.slug);
const isChannels = s.family === 'canales';

/* Para quién: sectores que lo usan, momentos que lo nombran (y «dejar las comisiones» en canales) */
const forSectors = sectors.filter((x) => x.modules.includes(s.slug)).map((x) => x.slug);
const forMoments = moments.filter(
  (m) => m.links.includes(s.slug) || (isChannels && m.slug === 'dejar-las-comisiones')
);
const guides = await getCollection(
  'guias',
  ({ data }) => !data.draft && data.related.includes(s.slug)
);
const hasForWho = Boolean(s.forWho?.length) || forSectors.length > 0;
const hasReading = forMoments.length > 0 || guides.length > 0;

/* Salidas: probar (si la demo existe), configurar, calcular (canales), demo o te llamamos */
/* El simulador se abre en la pantalla de cada producto (en móvil, en su pestaña) */
const screens: Partial<Record<SolutionSlug, 'comandero' | 'cocina' | 'caja'>> = {
  tpv: 'caja',
  comandero: 'comandero',
  cocina: 'cocina',
};
const pantalla = screens[s.slug];
const tryCta = demoCta(s.demo, origen, undefined, { pantalla });
const configure = {
  label: 'Monta tu alaCarta',
  href: ctaHref({ to: 'precios', add: s.slug, origen, hash: 'monta' }),
};
const calculator = {
  label: 'Calcula lo que pagas en comisiones',
  href: ctaHref({ to: 'calculadora', origen }),
};
const heroSecondary = tryCta ?? { label: 'Ver precio', href: '#precio' };
/* Cierre: las tres salidas (pruébalo · calcula · habla con nosotros) */
const closingTryCta = demoCta(s.demo, `${origen}-cierre`, 'Probar la demo', { pantalla });
const closingTry = closingTryCta ? { ...closingTryCta, text: demoShortTexts[s.demo!] } : undefined;
const closingCalc = {
  label: configure.label,
  href: ctaHref({ to: 'precios', add: s.slug, origen: `${origen}-cierre`, hash: 'monta' }),
  text: 'Suma esta pieza a tu configuración y mira el precio orientativo al momento.',
};
const demoTexts: Partial<Record<NonNullable<Solution['demo']>, string>> = {
  simulador:
    'Toma tú la comanda en el comandero, márcala como lista en cocina y cóbrala en la caja: las tres pantallas, sincronizadas, con la carta de un restaurante de ejemplo. Sin registrarte.',
  carta:
    'Abre en tu móvil la carta de ejemplo de La Plaza: categorías, alérgenos y cómo se pide desde la mesa. Sin registrarte.',
};

const jsonLd =
  s.schemaType === 'service'
    ? serviceJsonLd({ name: `${s.name} · alaCarta`, description: s.description, path })
    : softwareJsonLd({
        name: `${s.name} · alaCarta`,
        description: s.description,
        path,
        os: s.family === 'gestion' ? 'Web' : 'Web, Android, iOS',
        price: pricing.monthly,
        priceNote: pricing.offerNote,
      });
---

<BaseLayout
  title={s.seoTitle}
  description={s.description}
  path={path}
  jsonLd={[breadcrumbJsonLd(crumbs), jsonLd, faqJsonLd(s.faqs)]}
>
  <PageHero
    breadcrumbs={crumbs}
    eyebrow={family.name}
    eyebrowIcon={s.icon}
    title={s.title}
    text={s.intro}
    primary={{ label: 'Solicitar demo', href: ctaHref({ to: 'demo', modulo: s.slug, origen }) }}
    secondary={heroSecondary}
  >
    <PriceMini solution={s} slot="after-actions" />
    {s.heroVariant === 'demo' ? (
      <div class="sol-hero-plate">
        <QrPlate href={ctaHref({ to: 'carta', origen })} />
        <a href={ctaHref({ to: 'carta', origen })} class="btn is-secondary sol-hero-plate__btn">
          <Icon name="qr" size={16} />
          Abrir la carta de ejemplo
        </a>
      </div>
    ) : (
      <div class="sol-hero-media">
        <Mockup kind={s.mockup} />
      </div>
    )}
  </PageHero>

  {s.replaces && s.replaces.length > 0 && (
    <section class="section has-rule">
      <div class="container sol-split">
        <SectionHeader
          eyebrow="Lo que dejas de hacer"
          title="Lo de siempre, tachado"
          text={s.tagline}
        />
        <ReplacesTicket items={s.replaces} outcome={s.outcome} />
      </div>
    </section>
  )}

  <section class="section has-rule">
    <div class="container">
      <SectionHeader eyebrow="Qué hace" title={`${s.name}, en concreto`} />
      {s.featureGroups ? (
        <div class="sol-groups">
          {s.featureGroups.map((g) => (
            <div class="sol-group">
              <div class="sol-group__head">
                <h3>{g.title}</h3>
                {g.text && <p class="muted">{g.text}</p>}
              </div>
              <FeatureColumns items={g.features} columns={2} />
            </div>
          ))}
        </div>
      ) : (
        <FeatureColumns items={s.features} columns={3} />
      )}
    </div>
  </section>

  {tryCta && s.demo === 'simulador' && (
    <section class="section is-sm" id="pruebalo">
      <div class="container">
        <div class="sol-try">
          <span class="sol-try__icon">
            <Icon name="play" size={22} />
          </span>
          <div class="sol-try__copy">
            <h2>Pruébalo sin registrarte</h2>
            <p class="muted">{demoTexts.simulador}</p>
          </div>
          <a href={tryCta.href} class="btn is-primary">
            Abrir el simulador
            <Icon name="arrow-right" size={16} class="btn-arrow" />
          </a>
        </div>
      </div>
    </section>
  )}

  {s.demo === 'carta' && (
    <section class="section has-rule" id="pruebalo">
      <div class="container sol-carta">
        <div class="sol-carta__copy">
          <SectionHeader
            eyebrow="Pruébalo"
            title="Así la ve tu cliente"
            text="Es la carta de La Plaza, un restaurante de ejemplo: cambia de idioma, filtra por alérgenos, pide un plato y paga tu parte (simulado). Sin registrarte."
          />
          <div class="sol-carta__qr">
            <QrCode
              url={DEMO_CARTA_URL}
              size={176}
              label="Código QR que abre la carta de ejemplo"
            />
            <p>
              <b>Escanéalo con tu móvil:</b> así lo verá tu cliente. O pruébala aquí al lado.
            </p>
          </div>
          <a
            href={ctaHref({ to: 'carta', origen: `${origen}-demo` })}
            class="btn is-primary sol-carta__btn"
          >
            Abrir la carta de ejemplo
            <Icon name="arrow-right" size={16} class="btn-arrow" />
          </a>
        </div>
        <div class="sol-carta__phone">
          <DemoCarta client:visible mode="embed" origen={`${origen}-demo`} />
        </div>
      </div>
    </section>
  )}

  {s.demo === 'llamada' && (
    <section class="section has-rule" id="pruebalo">
      <div class="container">
        <SectionHeader
          eyebrow="Pruébalo"
          title="Así atiende una llamada"
          text="Tres llamadas de ejemplo a La Plaza, un restaurante ficticio. Sin audio: la conversación se escribe sola y, al colgar, ves lo que queda en tu sistema, pendiente de que tú decidas."
        />
        <CallDemo client:visible origen={`${origen}-demo`} />
      </div>
    </section>
  )}

  {s.demo === 'cambio-canales' && (
    <section class="section has-rule" id="pruebalo">
      <div class="container">
        <SectionHeader
          eyebrow="Pruébalo"
          title="Cambia un precio. Mira dónde cambia."
          text="Un backoffice reducido con tres platos de La Plaza, un restaurante de ejemplo. Sube un precio o marca un plato como agotado y mira el TPV, la carta QR, la tienda online y la app."
        />
        <ChannelsDemo client:visible origen={`${origen}-demo`} />
      </div>
    </section>
  )}

  <section class="section is-soft">
    <div class="container">
      <SectionHeader
        eyebrow="Conectado con el resto"
        title="Lo que gana al estar conectado"
        text="Nada trabaja solo: comparte la carta, las mesas, los clientes y los datos con el resto del sistema. Lo marcado «en camino» todavía no está hecho."
      />
      <ConnectionsDiagram solution={s} />
    </div>
  </section>

  {s.proofPoints && s.proofPoints.length > 0 && (
    <section class="section has-rule">
      <div class="container">
        <SectionHeader
          eyebrow="Datos del sector"
          title="Por qué importa"
          text="Cifras del mercado con su fuente. No son datos de clientes de alaCarta."
        />
        <ProofPoints items={s.proofPoints} />
      </div>
    </section>
  )}

  {s.hardware && s.hardware.length > 0 && (
    <section class="section has-rule">
      <div class="container">
        <SectionHeader
          eyebrow="Equipamiento recomendado"
          title="Lo que necesitas para usarlo"
          text="Te lo enviamos configurado y listo para enchufar. Si ya tienes equipo, lo revisamos y lo aprovechamos."
        />
        <HardwareCards items={s.hardware} />
      </div>
    </section>
  )}

  {(hasForWho || hasReading) && (
    <section class="section has-rule">
      <div class="container sol-for">
        {s.forWho && s.forWho.length > 0 && (
          <div>
            <SectionHeader eyebrow="Para quién" title="Pensado para" />
            <FeatureColumns items={s.forWho} columns={3} />
          </div>
        )}
        {forSectors.length > 0 && (
          <div>
            <SectionHeader
              eyebrow={s.forWho?.length ? 'Por tipo de local' : 'Para quién'}
              title="Sectores donde más aporta"
            />
            <SectorGrid only={forSectors} />
          </div>
        )}
        {hasReading && (
          <div class="sol-reading">
            {forMoments.length > 0 && (
              <div>
                <h3 class="sol-reading__title">Si estás en uno de estos momentos</h3>
                <ul role="list" class="sol-links">
                  {forMoments.map((m) => (
                    <li>
                      <a href={momentPath(m.slug)} class="sol-link">
                        <Icon name={m.icon} size={18} />
                        <span>
                          <b>{m.navLabel}</b>
                          <span>{m.tagline}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                  {isChannels && (
                    <li>
                      <a href={calculator.href} class="sol-link">
                        <Icon name="calculator" size={18} />
                        <span>
                          <b>Calculadora de comisiones</b>
                          <span>Lo que te cuestan al año los pedidos por agregador.</span>
                        </span>
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            )}
            {guides.length > 0 && (
              <div>
                <h3 class="sol-reading__title">Para leer con calma</h3>
                <ul role="list" class="sol-links">
                  {guides.map((g) => (
                    <li>
                      <a href={`/recursos/guias/${g.id}`} class="sol-link">
                        <Icon name="book" size={18} />
                        <span>
                          <b>{g.data.title}</b>
                          <span>{g.data.readingMinutes} min de lectura</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  <PriceBand solution={s} origen={`${origen}-precio`} />

  <FaqSection items={s.faqs} title={`Preguntas sobre ${s.navLabel}`} />

  <CtaBand
    title={s.closingTitle}
    modulo={s.slug}
    origen={`${origen}-cierre`}
    tryLink={closingTry}
    calcLink={closingCalc}
  />
</BaseLayout>

<style>
  .sol-hero-media {
    display: flex;
    justify-content: center;
  }
  .sol-hero-media :global(.device.is-phone) {
    max-width: 16rem;
  }
  .sol-hero-plate {
    display: grid;
    justify-items: center;
  }
  .sol-hero-plate__btn {
    display: none;
  }
  .sol-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }
  .sol-split :global(.section-header) {
    margin-bottom: 0;
  }
  .sol-groups {
    display: grid;
    gap: var(--space-16);
  }
  .sol-group {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr);
    gap: var(--space-10);
  }
  .sol-group__head {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .sol-group__head h3 {
    font-size: var(--text-2xl);
  }
  .sol-try {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6) var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }
  .sol-try__icon {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--black);
    color: var(--white);
  }
  .sol-try__copy {
    display: grid;
    gap: var(--space-2);
  }
  .sol-try__copy h2 {
    font-size: var(--text-xl);
  }
  .sol-carta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    gap: var(--space-16);
    align-items: center;
  }
  .sol-carta__copy {
    display: grid;
    gap: var(--space-8);
    justify-items: start;
  }
  .sol-carta__copy :global(.section-header) {
    margin-bottom: 0;
  }
  .sol-carta__qr {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    max-width: 32rem;
  }
  .sol-carta__qr p {
    color: var(--color-text-muted);
  }
  .sol-carta__qr b {
    color: var(--color-text-strong);
    font-weight: var(--weight-medium);
  }
  .sol-carta__btn {
    display: none;
  }
  .sol-for {
    display: grid;
    gap: var(--space-16);
  }
  .sol-reading {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-10);
  }
  .sol-reading__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }
  .sol-links {
    display: grid;
    gap: var(--space-2);
  }
  .sol-link {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-strong);
  }
  .sol-link:hover {
    text-decoration: none;
  }
  .sol-link:hover b {
    text-decoration: underline;
  }
  .sol-link :global(.icon) {
    margin-top: 0.15rem;
    color: var(--color-text-muted);
  }
  .sol-link b {
    display: block;
    font-weight: var(--weight-medium);
  }
  .sol-link span span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (max-width: 1024px) {
    .sol-split,
    .sol-group {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
  @media (max-width: 720px) {
    .sol-hero-plate :global(.plate-stage) {
      display: none;
    }
    .sol-hero-plate__btn {
      display: inline-flex;
    }
    .sol-try {
      grid-template-columns: 1fr;
      padding: var(--space-6);
    }
    .sol-carta {
      grid-template-columns: 1fr;
    }
    .sol-carta__qr,
    .sol-carta__phone {
      display: none;
    }
    .sol-carta__btn {
      display: inline-flex;
    }
    .sol-reading {
      grid-template-columns: 1fr;
    }
  }
</style>
