---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import FaqSection from '@/components/blocks/FaqSection.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import PricingPlans from '@/components/islands/PricingPlans.vue';
import {
  plans,
  addonModules,
  devices,
  services,
  fmtPrice,
  VAT_NOTE,
  TRIAL_DAYS,
  ANNUAL_DISCOUNT,
  FROM_PRICE,
  PRICES_ARE_ESTIMATES,
} from '@/data/pricing';
import { solutions } from '@/data/solutions';
import { pricingFaqs } from '@/data/faqs';
import { breadcrumbJsonLd, faqJsonLd } from '@/lib/seo';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Precios', path: '/precios' },
];
---

<BaseLayout
  title={`Precios: software de hostelería desde ${fmtPrice(FROM_PRICE)}/mes, sin comisiones`}
  description={`Planes de alaCarta por local y mes, sin permanencia y sin comisiones por reserva, pedido o QR. Esencial desde ${fmtPrice(FROM_PRICE)}/mes; Completo con todos los módulos; Grupos a medida.`}
  path="/precios"
  jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(pricingFaqs)]}
>
  <PageHero
    variant="center"
    eyebrow="Precios"
    title="Un precio por local. Sin comisiones, sin permanencia."
    text={`Cuota fija al mes por cada local, con los módulos que necesites. Ni comisión por reserva, ni por pedido online, ni por pago por QR. ${TRIAL_DAYS} días de prueba sin tarjeta y un ${ANNUAL_DISCOUNT} % menos si pagas el año.`}
  />

  <section class="section is-sm" id="planes">
    <div class="container">
      <PricingPlans client:visible />
      <p class="pricing-note muted">
        Precios por local y mes, {VAT_NOTE}.{' '}
        {PRICES_ARE_ESTIMATES &&
          'Tarifa orientativa de lanzamiento: la confirmamos en la propuesta que te enviamos tras la demo.'}
      </p>
    </div>
  </section>

  <section class="section is-soft" id="modulos">
    <div class="container">
      <SectionHeader
        eyebrow="Qué incluye cada plan"
        title="Módulo a módulo"
        text="El Esencial puede añadir cualquier módulo por separado. El Completo los lleva todos."
      />
      <div class="table-wrap">
        <table class="plan-table">
          <thead>
            <tr>
              <th scope="col">Módulo</th>
              {plans.map((p) => (
                <th scope="col">{p.name}</th>
              ))}
              <th scope="col">Suelto sobre Esencial</th>
            </tr>
          </thead>
          <tbody>
            {solutions.map((s) => {
              const addon = addonModules.find((a) => a.module === s.slug);
              return (
                <tr>
                  <th scope="row">
                    <a href={`/soluciones/${s.slug}`}>{s.name}</a>
                  </th>
                  {plans.map((p) => (
                    <td>
                      {p.modules.includes(s.slug) ? (
                        <Icon name="check" size={18} title="Incluido" />
                      ) : (
                        <span class="muted" aria-label="No incluido">
                          —
                        </span>
                      )}
                    </td>
                  ))}
                  <td>
                    {addon ? (
                      <span>
                        <span class="num">{fmtPrice(addon.monthly)}</span>/mes
                        {addon.note && <span class="muted plan-table__note"> · {addon.note}</span>}
                      </span>
                    ) : (
                      <span class="muted">Incluido</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="dispositivos">
    <div class="container pricing-cols">
      <div>
        <SectionHeader
          eyebrow="Dispositivos"
          title="Añade los que necesites"
          text="Cada plan incluye los dispositivos indicados. Los demás se suman por unidad y se pueden dar de baja por temporada."
        />
        <ul role="list" class="price-list">
          {devices.map((d) => (
            <li>
              <span>{d.name}</span>
              <span class="num">
                <strong>{fmtPrice(d.monthly)}</strong>/mes
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <SectionHeader
          eyebrow="Puesta en marcha"
          title="Para empezar bien"
          text="La configuración remota está incluida en todos los planes. Lo presencial se contrata aparte."
        />
        <ul role="list" class="price-list">
          {services.map((s) => (
            <li class="is-stack">
              <div class="price-list__row">
                <span>{s.name}</span>
                <span class="num">
                  <strong>{s.price}</strong>
                </span>
              </div>
              <p class="muted">{s.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section is-soft">
    <div class="container">
      <SectionHeader
        eyebrow="Lo que no cobramos"
        title="Cero comisiones, de verdad"
        align="center"
      />
      <ul role="list" class="zero-grid">
        <li class="column">
          <h3>0 % por reserva</h3>
          <p>Las reservas desde tu web o Google no llevan coste por comensal.</p>
        </li>
        <li class="column">
          <h3>0 % por pedido online</h3>
          <p>Tu tienda de take away y reparto propio, con cuota fija. El dinero va a tu cuenta.</p>
        </li>
        <li class="column">
          <h3>0 % por pago QR</h3>
          <p>El pago en mesa desde la carta solo paga la comisión de tu pasarela.</p>
        </li>
        <li class="column">
          <h3>0 € de alta</h3>
          <p>La puesta en marcha remota y la importación de la carta están incluidas.</p>
        </li>
      </ul>
    </div>
  </section>

  <FaqSection items={pricingFaqs} title="Preguntas sobre precios" />

  <CtaBand
    title="¿Qué plan te encaja?"
    text="En la demo repasamos tu local y te decimos qué módulos necesitas de verdad. La propuesta llega por escrito, con el precio cerrado."
  />
</BaseLayout>

<style>
  .pricing-note {
    margin-top: var(--space-6);
    text-align: center;
    font-size: var(--text-xs);
    max-width: 44rem;
    margin-inline: auto;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--white);
  }
  .plan-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    min-width: 40rem;
  }
  .plan-table th,
  .plan-table td {
    padding: var(--space-4) var(--space-5);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  .plan-table thead th {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-soft);
  }
  .plan-table tbody tr:last-child td,
  .plan-table tbody tr:last-child th {
    border-bottom: 0;
  }
  .plan-table tbody th {
    font-weight: var(--weight-medium);
    color: var(--color-text-strong);
  }
  .plan-table tbody th a:hover {
    text-decoration: underline;
  }
  .plan-table td:nth-child(n + 2):nth-child(-n + 4) {
    text-align: center;
    width: 8rem;
  }
  .plan-table__note {
    font-size: var(--text-xs);
  }
  .num {
    font-variant-numeric: tabular-nums;
  }
  .pricing-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  .price-list {
    border-top: 1px solid var(--color-border);
  }
  .price-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .price-list li.is-stack {
    flex-direction: column;
    gap: var(--space-2);
  }
  .price-list__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .price-list p {
    font-size: var(--text-sm);
  }
  .zero-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .zero-grid h3 {
    font-size: var(--text-xl);
  }
  @media (max-width: 1024px) {
    .pricing-cols {
      grid-template-columns: 1fr;
    }
    .zero-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .zero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
