---
/**
 * Confirmación tras enviar un formulario (docs/auditoria/11 §5). `noindex`.
 *
 * La variante sale de la URL: `?tipo=demo|llamada|propuesta|fundador|contacto`, `momento=` (para
 * la guía de «mientras tanto») y `via=correo` (si se envió por correo porque no hay endpoint). El
 * nombre, el correo y la franja **no** viajan en la URL: el formulario los deja en sessionStorage
 * (`alacarta:solicitud`) y aquí se leen con try/catch. Sin JavaScript se ve la variante «demo».
 *
 * Evento de conversión: se dispara aquí (`alacarta:conversion`), no en el clic, para cuando haya
 * analítica (docs/TODO.md). Hoy no lo escucha nadie.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { CONTACT_EMAIL, DEMO_MINUTES, REPLY_HOURS, SUPPORT_EMAIL } from '@/data/site';
import { TRIAL_DAYS, ONSITE_TRAINING_FROM } from '@/data/pricing';
import { ctaHref } from '@/lib/cta';

type V = 'demo' | 'llamada' | 'propuesta' | 'fundador' | 'contacto';
const ALL = 'demo llamada propuesta fundador contacto';
const SALES = 'demo llamada propuesta fundador';

const heads: { v: V; title: string; lead: string }[] = [
