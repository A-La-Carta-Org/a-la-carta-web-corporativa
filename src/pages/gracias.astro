    v: 'llamada',
    title: 'Hecho. Te llamamos.',
    lead: `Te llamamos en menos de ${REPLY_HOURS} horas laborables, {franja}.`,
  },
  {
    v: 'propuesta',
    title: 'Gracias. Nos ponemos con tu propuesta.',
    lead: `Te escribimos a {email} en menos de ${REPLY_HOURS} horas laborables para confirmar lo que has montado y mandarte la propuesta por escrito.`,
  },
  {
    v: 'fundador',
    title: 'Gracias por querer ser de los primeros.',
    lead: `Revisamos tu solicitud y te escribimos a {email} en menos de ${REPLY_HOURS} horas laborables con las condiciones de local fundador por escrito.`,
  },
  {
    v: 'contacto',
    title: 'Mensaje recibido.',
    lead: `Lo lee una persona del equipo y te contestamos a {email} en menos de ${REPLY_HOURS} horas laborables.`,
  },
];

const steps: { v: string; title: string; text: string }[] = [
