---
/**
 * Placa QR de mesa dibujada (metacrilato negro) con un QR que funciona: abre la carta de ejemplo.
 * La usan la página de placas, la de carta QR y el hub de soluciones. En móvil no tiene sentido
 * escanear la pantalla: el pie cambia a un enlace «Abrir la carta de ejemplo».
 */
import QrCode from '@/components/ui/QrCode.astro';
import Icon from '@/components/ui/Icon.astro';
import { DEMO_CARTA_URL } from '@/data/navigation';

interface Props {
  brand?: string;
  table?: string;
  /** Enlace del pie (con su `origen`); sin él no se pinta el pie */
  href?: string;
  /** Lado del QR en píxeles */
  size?: number;
  class?: string;
}
const {
  brand = 'La Plaza',
  table = 'Mesa 7',
  href,
  size = 148,
  class: className = '',
} = Astro.props;
---

<div class:list={['plate-stage', className]}>
  <figure class="plate" aria-label={`Placa de ejemplo: ${brand}, ${table.toLowerCase()}`}>
    <div class="plate__face">
      <p class="plate__brand">{brand}</p>
      <div class="plate__qr">
        <QrCode url={DEMO_CARTA_URL} size={size} label="Código QR que abre la carta de ejemplo" />
      </div>
      <p class="plate__hint">Escanea para ver la carta y pedir</p>
      <p class="plate__table">{table}</p>
    </div>
    <div class="plate__base" aria-hidden="true"></div>
  </figure>
  {href && (
    <p class="plate-stage__caption muted">
      <span class="plate-stage__desk">Escanéala con tu móvil: abre la carta de ejemplo.</span>
      <a href={href} class="link-arrow">
        Abrir la carta de ejemplo
        <Icon name="arrow-right" size={14} />
      </a>
    </p>
  )}
</div>

<style>
  .plate-stage {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
  }
  .plate {
    display: grid;
    justify-items: center;
    margin: 0;
  }
  .plate__face {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    width: 15rem;
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: var(--black);
    color: var(--white);
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-sm) var(--radius-sm);
    box-shadow: var(--shadow-device);
  }
  .plate__brand {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-snug);
    font-size: var(--text-lg);
  }
  .plate__qr {
    padding: var(--space-3);
    background: var(--white);
    border-radius: var(--radius-md);
    line-height: 0;
  }
  .plate__hint {
    font-size: var(--text-xs);
    color: var(--gray-300);
  }
  .plate__table {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }
  .plate__base {
    width: 17rem;
    height: 0.75rem;
    background: var(--gray-800);
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  }
  .plate-stage__caption {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    text-align: center;
  }
  @media (max-width: 720px) {
    .plate-stage__desk {
      display: none;
    }
  }
</style>
