---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}
const { eyebrow, title, text, align = 'left', as: Tag = 'h2', class: className = '' } = Astro.props;
---

<div class:list={['section-header', className, { 'is-center': align === 'center' }]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag>{title}</Tag>
  {text && <p>{text}</p>}
  <slot />
</div>
