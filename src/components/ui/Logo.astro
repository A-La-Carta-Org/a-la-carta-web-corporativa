---
/**
 * Logotipo de alaCarta.
 *
 * Símbolo: una rejilla de 2×2 módulos con esquinas suaves, uno de ellos relleno. Dice
 * «elige los módulos que necesitas»: una plataforma a la carta. Monocromo, funciona a 16 px.
 * Palabra: «alaCarta» en Manrope semibold con la C en mayúscula como única marca de ritmo.
 */
interface Props {
  variant?: 'full' | 'mark' | 'word';
  inverse?: boolean;
  size?: number; // alto en px
  class?: string;
}
const { variant = 'full', inverse = false, size = 28, class: className = '' } = Astro.props;
const color = inverse ? '#ffffff' : '#0b0b0a';
---

<span class:list={['logo', className, { 'is-inverse': inverse }]} style={`--logo-h:${size}px`}>
  {variant !== 'word' && (
    <svg
      class="logo-mark"
      viewBox="0 0 32 32"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
    >
      <rect x="2" y="2" width="12.5" height="12.5" rx="3.5" fill={color} />
      <rect
        x="17.5"
        y="2"
        width="12.5"
        height="12.5"
        rx="3.5"
        fill="none"
        stroke={color}
        stroke-width="2"
      />
      <rect
        x="2"
        y="17.5"
        width="12.5"
        height="12.5"
        rx="3.5"
        fill="none"
        stroke={color}
        stroke-width="2"
      />
      <rect
        x="17.5"
        y="17.5"
        width="12.5"
        height="12.5"
        rx="3.5"
        fill="none"
        stroke={color}
        stroke-width="2"
      />
    </svg>
  )}
  {variant !== 'mark' && <span class="logo-word">alaCarta</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-h) * 0.32);
    color: var(--color-text-strong);
    line-height: 1;
  }
  .logo.is-inverse {
    color: var(--white);
  }
  .logo-mark {
    flex: 0 0 auto;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: calc(var(--logo-h) * 0.82);
    letter-spacing: -0.035em;
  }
</style>
