---
/**
 * Código QR generado en build como SVG (sin JavaScript en el navegador). Pensado para que el
 * visitante lo escanee con OTRO dispositivo, así que la URL debe ser absoluta.
 *
 * Monocromo, con el negro de la marca y el fondo transparente para que funcione sobre blanco o
 * gris claro. Corrección de errores media: aguanta bien impresiones pequeñas y reflejos.
 */
import QRCode from 'qrcode';

interface Props {
  /** URL absoluta a la que apunta el QR */
  url: string;
  /** Lado en píxeles */
  size?: number;
  /** Texto accesible: qué abre el código */
  label?: string;
  class?: string;
}
const { url, size = 96, label, class: className = '' } = Astro.props;

const svg = await QRCode.toString(url, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#0b0b0aff', light: '#00000000' },
});
// El SVG trae su propio viewBox: se le quitan las medidas para que mande el contenedor
const clean = svg.replace(/\s(width|height)="[^"]*"/g, '');
const accessible = label ?? `Código QR que abre ${url}`;
---

<span
  class:list={['qr-code', className]}
  style={`--qr-size:${size}px`}
  role="img"
  aria-label={accessible}
  set:html={clean}
/>

<style>
  .qr-code {
    display: inline-block;
    width: var(--qr-size);
    height: var(--qr-size);
    flex: 0 0 auto;
    line-height: 0;
  }
  .qr-code :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    shape-rendering: crispEdges;
  }
</style>
