---
/**
 * Hero de página. Dos variantes:
 * - `split`: texto a la izquierda y maqueta (slot) a la derecha. Para producto y sectores.
 * - `compact`: una columna, antetítulo, H1 y una línea. Para precios, recursos, contacto.
 *
 * Slots: el por defecto es la maqueta (solo en `split`); `after-actions` va bajo los botones
 * (la mini-tarjeta de precio de las páginas de producto).
 */
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import StatusChip from '@/components/ui/StatusChip.astro';
import type { SolutionStatus } from '@/data/solutions';

/**
 * Los `href` de los botones se construyen con `ctaHref()` (src/lib/cta.ts) en cada página, para
 * que lleven su contexto (`origen`, `modulo`, `sector`).
 */
interface Props {
  eyebrow?: string;
  /** Icono de línea delante del antetítulo */
  eyebrowIcon?: IconName;
  /** Estado del producto: el chip solo aparece si no está disponible */
  status?: SolutionStatus;
  statusNote?: string;
  title: string;
  text?: string;
  variant?: 'split' | 'compact' | 'center';
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  breadcrumbs?: { name: string; path: string }[];
  note?: string;
}
const {
  eyebrow,
  eyebrowIcon,
  status,
  statusNote,
  title,
  text,
  variant = 'split',
  primary,
  secondary,
  breadcrumbs,
  note,
} = Astro.props;
---

<section class:list={['page-hero', `is-${variant}`]}>
  <div class="container page-hero__inner">
    <div class="page-hero__copy">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      {(eyebrow || status) && (
        <div class="page-hero__eyebrow">
          {eyebrow && (
            <span class:list={['eyebrow', { 'has-icon': eyebrowIcon }]}>
              {eyebrowIcon && <Icon name={eyebrowIcon} size={16} />}
              {eyebrow}
            </span>
          )}
          <StatusChip status={status} note={statusNote} />
        </div>
      )}
      <h1>{title}</h1>
      {text && <p class="lead">{text}</p>}
      {(primary || secondary) && (
        <div class="page-hero__actions">
          {primary && (
            <a href={primary.href} class="btn is-primary is-lg">
              {primary.label}
              <Icon name="arrow-right" size={16} class="btn-arrow" />
            </a>
          )}
          {secondary && (
            <a href={secondary.href} class="btn is-secondary is-lg">
              {secondary.label}
            </a>
          )}
        </div>
      )}
      <slot name="after-actions" />
      {note && <p class="page-hero__note muted">{note}</p>}
      {status && status !== 'disponible' && statusNote && (
        <p class="page-hero__note muted">{statusNote}</p>
      )}
    </div>
    {variant === 'split' && (
      <div class="page-hero__media">
        <slot />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem) clamp(2rem, 1.5rem + 2vw, 4rem);
  }
  .page-hero__inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }
  .is-split .page-hero__inner {
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  }
  .page-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
  }
  .is-center .page-hero__copy {
    align-items: center;
    text-align: center;
    margin-inline: auto;
    max-width: 52rem;
  }
  .is-center .lead {
    margin-inline: auto;
  }
  .is-compact .page-hero__copy {
    max-width: 46rem;
  }
  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .page-hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .is-center .page-hero__eyebrow {
    justify-content: center;
  }
  .eyebrow.has-icon::before {
    display: none;
  }
  .page-hero__note {
    font-size: var(--text-sm);
  }
  .page-hero__media {
    min-width: 0;
  }
  @media (max-width: 1024px) {
    .is-split .page-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
