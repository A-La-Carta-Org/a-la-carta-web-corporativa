---
/**
 * «Lo que dejas de hacer» (docs/auditoria/04 §4.2): lo de antes, tachado en gris, y la frase de
 * resultado. Con forma de ticket, corto.
 */
interface Props {
  items: string[];
  outcome?: string;
}
const { items, outcome } = Astro.props;
---

<div class="ticket">
  <p class="ticket__head">
    <span>Antes</span>
    <span class="num">{String(items.length).padStart(2, '0')}</span>
  </p>
  <ul role="list" class="ticket__list">
    {items.map((it) => (
      <li>
        <s>{it}</s>
      </li>
    ))}
  </ul>
  {outcome && (
    <>
      <p class="ticket__head is-after">
        <span>Con alaCarta</span>
      </p>
      <p class="ticket__outcome">{outcome}</p>
    </>
  )}
</div>

<style>
  .ticket {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--white);
  }
  .ticket__head {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .ticket__head.is-after {
    padding-top: var(--space-4);
    border-top: 1.5px dashed var(--color-border-strong);
    color: var(--color-text-strong);
  }
  .ticket__list {
    display: grid;
    gap: var(--space-3);
  }
  .ticket__list li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }
  .ticket__list li::before {
    content: '×';
    flex: 0 0 auto;
    font-family: var(--font-mono);
    color: var(--color-text-subtle);
  }
  .ticket__list s {
    text-decoration-thickness: 1px;
    text-decoration-color: var(--gray-400);
  }
  .ticket__outcome {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-strong);
  }
</style>
