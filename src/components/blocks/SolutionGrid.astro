---
/** Las soluciones como tarjetas sobrias con icono de línea. */
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/Icon.astro';
import { solutions, solutionPath, type SolutionSlug } from '@/data/solutions';

interface Props {
  only?: SolutionSlug[];
  columns?: 3 | 4;
  compact?: boolean;
}
const { only, columns = 3, compact = false } = Astro.props;
const list = only
  ? only.map((s) => solutions.find((x) => x.slug === s)!).filter(Boolean)
  : solutions;

const solutionIcons: Record<SolutionSlug, IconName> = {
  tpv: 'tpv',
  comandero: 'phone',
  cocina: 'kitchen',
  'carta-qr': 'qr',
  reservas: 'calendar',
  pedidos: 'bag',
  gestion: 'settings',
  informes: 'chart',
  clientes: 'users',
};
---

<ul role="list" class:list={['solution-grid', `is-${columns}`, { 'is-compact': compact }]}>
  {list.map((s) => (
    <li>
      <a href={solutionPath(s.slug)} class="solution-card">
        <span class="solution-card__icon">
          <Icon name={solutionIcons[s.slug]} size={20} />
        </span>
        <span class="solution-card__body">
          <span class="solution-card__name">{s.navLabel}</span>
          {!compact && <span class="solution-card__text">{s.tagline}</span>}
        </span>
        <Icon name="arrow-right" size={16} class="solution-card__arrow" />
      </a>
    </li>
  ))}
</ul>

<style>
  .solution-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .solution-grid.is-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .solution-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .solution-card:hover {
    border-color: var(--color-ink);
    text-decoration: none;
  }
  .is-compact .solution-card {
    padding: var(--space-4);
    align-items: center;
  }
  .solution-card__icon {
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-bg-muted);
    color: var(--color-text-strong);
  }
  .solution-card__body {
    display: grid;
    gap: var(--space-1);
    flex: 1 1 auto;
  }
  .solution-card__name {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-strong);
  }
  .solution-card__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }
  .solution-card :global(.solution-card__arrow) {
    color: var(--color-text-subtle);
    margin-top: 0.6rem;
    transition: translate var(--dur-fast) var(--ease);
  }
  .is-compact :global(.solution-card__arrow) {
    margin-top: 0;
  }
  .solution-card:hover :global(.solution-card__arrow) {
    translate: 3px 0;
    color: var(--color-text-strong);
  }
  @media (max-width: 1024px) {
    .solution-grid,
    .solution-grid.is-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .solution-grid,
    .solution-grid.is-4 {
      grid-template-columns: 1fr;
    }
  }
</style>
