---
/**
 * Visual del hero de la home (docs/auditoria/03 §3.1, alternativa sin mapa): el TPV como base,
 * la carta QR en el móvil del cliente, la placa QR de la mesa (con un QR que funciona) y una
 * tarjeta flotante de «Llamada con IA» con su chip de estado. Solo HTML y CSS: el hero no
 * depende de JavaScript.
 *
 * En móvil se queda el TPV con la tarjeta de llamada; el teléfono y la placa se ocultan para que
 * el primer pantallazo no sea un collage ilegible.
 */
import Mockup from '@/components/mockups/Mockup.astro';
import QrPlate from '@/components/ui/QrPlate.astro';
import Icon from '@/components/ui/Icon.astro';
import StatusChip from '@/components/ui/StatusChip.astro';
import { getSolution } from '@/data/solutions';

const ia = getSolution('llamadas-ia');
---

<div
  class="hh"
  role="img"
  aria-label="El mismo sistema en varias pantallas: el TPV de sala, la carta QR en el móvil del cliente, la placa QR de la mesa y una llamada atendida por el asistente que deja una reserva por confirmar"
>
  <div class="hh__tpv" aria-hidden="true">
    <Mockup kind="tpv" />
  </div>
  <div class="hh__phone" aria-hidden="true">
    <Mockup kind="carta" />
  </div>
  <div class="hh__plate" aria-hidden="true">
    <QrPlate size={88} />
  </div>
  <div class="hh__call" aria-hidden="true">
    <span class="hh__call-icon">
      <Icon name="ai-call" size={18} />
    </span>
    <span class="hh__call-body">
      <span class="hh__call-head">
        <b>Llamada con IA</b>
        <StatusChip status={ia.status} />
      </span>
      <span class="hh__call-text">Reserva por confirmar</span>
      <span class="hh__call-meta num">Sáb 21:00 · 4 personas · terraza</span>
    </span>
  </div>
</div>

<style>
  .hh {
    position: relative;
    padding: var(--space-12) 0 var(--space-12) var(--space-8);
  }
  .hh__tpv {
    position: relative;
  }
  /* El móvil y la placa se dibujan a su tamaño natural y se reducen con zoom, para que su
     maqueta no se reorganice como si fuera una pantalla estrecha */
  .hh__phone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 17rem;
    zoom: 0.62;
    z-index: 2;
  }
  .hh__plate {
    position: absolute;
    right: var(--space-6);
    bottom: 0;
    zoom: 0.5;
    z-index: 2;
  }
  .hh__call {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 3;
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    width: 17rem;
    padding: var(--space-3) var(--space-4);
    background: var(--white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  .hh__call-icon {
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--black);
    color: var(--white);
  }
  .hh__call-body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .hh__call-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-strong);
  }
  .hh__call-head b {
    font-weight: var(--weight-semibold);
  }
  .hh__call-text {
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .hh__call-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .hh {
      max-width: 44rem;
      margin-inline: auto;
    }
  }
  @media (max-width: 720px) {
    .hh {
      padding: 4.75rem 0 0;
    }
    .hh__phone,
    .hh__plate {
      display: none;
    }
    /* El TPV se dibuja con su ancho de escritorio y se reduce: así enseña sala y carta en dos
       columnas en vez de una tira de 800 px de alto */
    .hh__tpv {
      width: 38rem;
      zoom: 0.8;
      margin-inline: auto;
    }
    .hh__call {
      right: var(--space-3);
      width: auto;
      max-width: calc(100% - var(--space-6));
    }
  }
  @media (max-width: 520px) {
    .hh__tpv {
      zoom: 0.54;
    }
  }
</style>
