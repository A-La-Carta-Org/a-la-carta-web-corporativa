---
/** Tres o cuatro cosas en paralelo, con filete arriba. Sin tarjetas. */
import type { Feature } from '@/data/solutions';

interface Props {
  items: Feature[];
  columns?: 2 | 3 | 4;
}
const { items, columns = 3 } = Astro.props;
---

<ul role="list" class="feature-columns" style={`--cols:${columns}`}>
  {items.map((f) => (
    <li class="column">
      <h3>{f.title}</h3>
      <p>{f.text}</p>
    </li>
  ))}
</ul>

<style>
  .feature-columns {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-10) var(--space-8);
  }
  @media (max-width: 1024px) {
    .feature-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .feature-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
