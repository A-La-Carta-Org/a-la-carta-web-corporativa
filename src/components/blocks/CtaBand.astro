---
/** Cierre de página: una banda oscura con el titular, una línea y los dos botones. */
import Icon from '@/components/ui/Icon.astro';
import { TRIAL_DAYS } from '@/data/pricing';

interface Props {
  title?: string;
  text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  title = 'Vamos a ver tu local',
  text = `En una videollamada corta repasamos tu carta, tus canales y tu equipo, y te enseñamos la plataforma con un caso como el tuyo. Después, ${TRIAL_DAYS} días de prueba sin tarjeta.`,
  primary = { label: 'Solicitar demo', href: '/solicitar-demo' },
  secondary = { label: 'Ver precios', href: '/precios' },
} = Astro.props;
---

<section class="section is-dark cta-band">
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2>{title}</h2>
      <p class="muted">{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href={primary.href} class="btn is-inverse is-lg">
        {primary.label}
        <Icon name="arrow-right" size={16} class="btn-arrow" />
      </a>
      {secondary && (
        <a href={secondary.href} class="btn is-inverse-outline is-lg">
          {secondary.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-10);
    align-items: center;
  }
  .cta-band__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 36rem;
  }
  .cta-band__copy h2 {
    font-size: var(--text-4xl);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: flex-end;
  }
  @media (max-width: 1024px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
    }
    .cta-band__actions {
      justify-content: flex-start;
    }
  }
</style>
