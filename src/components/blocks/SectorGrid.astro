---
/** Los sectores como lista de enlaces con filete, sin tarjetas. */
import Icon from '@/components/ui/Icon.astro';
import { sectors, sectorPath, type SectorSlug } from '@/data/sectors';

interface Props {
  only?: SectorSlug[];
}
const { only } = Astro.props;
const list = only ? only.map((s) => sectors.find((x) => x.slug === s)!).filter(Boolean) : sectors;
---

<ul role="list" class="sector-grid">
  {list.map((s) => (
    <li>
      <a href={sectorPath(s.slug)} class="sector-link">
        <span class="sector-link__name">{s.name}</span>
        <span class="sector-link__text">{s.tagline}</span>
        <Icon name="arrow-right" size={16} class="sector-link__arrow" />
      </a>
    </li>
  ))}
</ul>

<style>
  .sector-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--space-8);
  }
  .sector-link {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-8) var(--space-5) 0;
    border-top: 1px solid var(--color-border);
    height: 100%;
  }
  .sector-link:hover {
    text-decoration: none;
  }
  .sector-link__name {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-strong);
  }
  .sector-link__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .sector-link__arrow {
    position: absolute;
    right: 0;
    top: var(--space-6);
    color: var(--color-text-subtle);
    transition: translate var(--dur-fast) var(--ease);
  }
  .sector-link:hover .sector-link__arrow {
    translate: 3px 0;
    color: var(--color-text-strong);
  }
  @media (max-width: 1024px) {
    .sector-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .sector-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
