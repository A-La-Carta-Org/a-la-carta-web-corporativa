---
/**
 * Composición de un kit (hero de /hardware): terminal sobre el cajón, impresora con ticket,
 * comandero, pantalla de cocina en la pared y placa QR. Dibujada en el lenguaje de las maquetas
 * (líneas finas, grises, negro solo para lo que se toca), sin fotos ni marcas reales.
 */
const parts = [
  'Terminal táctil',
  'Impresora de tickets',
  'Cajón',
  'Comandero',
  'Pantalla de cocina',
  'Placa QR',
];
---

<figure class="kit">
  <svg
    class="kit__art"
    viewBox="0 0 600 390"
    role="img"
    aria-label="Kit de ejemplo: terminal táctil sobre el cajón, impresora de tickets, móvil de comandero, pantalla de cocina en la pared y placa QR de mesa"
  >
    <!-- Pantalla de cocina en la pared -->
    <g class="kit__kds">
      <rect class="s-line f-white" x="356" y="24" width="220" height="136" rx="10" />
      <rect class="f-soft" x="366" y="34" width="200" height="116" rx="4" />
      <g>
        <rect class="s-light f-white" x="374" y="42" width="58" height="100" rx="3" />
        <rect class="f-ink" x="374" y="42" width="58" height="12" rx="3" />
        <rect class="f-light" x="381" y="62" width="40" height="5" rx="2" />
        <rect class="f-light" x="381" y="73" width="30" height="5" rx="2" />
        <rect class="f-light" x="381" y="84" width="36" height="5" rx="2" />
        <rect class="f-ok" x="381" y="124" width="22" height="9" rx="4.5" />
      </g>
      <g>
        <rect class="s-light f-white" x="437" y="42" width="58" height="100" rx="3" />
        <rect class="f-mid" x="437" y="42" width="58" height="12" rx="3" />
        <rect class="f-light" x="444" y="62" width="34" height="5" rx="2" />
        <rect class="f-light" x="444" y="73" width="42" height="5" rx="2" />
        <rect class="f-warn" x="444" y="124" width="22" height="9" rx="4.5" />
      </g>
      <g>
        <rect class="s-light f-white" x="500" y="42" width="58" height="100" rx="3" />
        <rect class="f-mid" x="500" y="42" width="58" height="12" rx="3" />
        <rect class="f-light" x="507" y="62" width="40" height="5" rx="2" />
        <rect class="f-light" x="507" y="73" width="26" height="5" rx="2" />
        <rect class="f-light" x="507" y="84" width="34" height="5" rx="2" />
        <rect class="f-light" x="507" y="95" width="22" height="5" rx="2" />
      </g>
      <rect class="f-light" x="456" y="160" width="20" height="12" />
    </g>

    <!-- Terminal táctil -->
    <g class="kit__tpv">
      <rect class="s-line f-white" x="92" y="104" width="232" height="164" rx="12" />
      <rect class="f-soft" x="104" y="116" width="208" height="140" rx="4" />
      <rect class="s-light f-white" x="104" y="116" width="208" height="18" rx="4" />
      <rect class="f-ink" x="112" y="122" width="26" height="6" rx="3" />
      <rect class="f-light" x="144" y="122" width="22" height="6" rx="3" />
      <rect class="f-light" x="172" y="122" width="22" height="6" rx="3" />
      <g class="kit__tiles">
        <rect class="f-ink" x="112" y="142" width="40" height="26" rx="4" />
        <rect class="s-light f-white" x="158" y="142" width="40" height="26" rx="4" />
        <rect class="s-light f-white" x="204" y="142" width="40" height="26" rx="4" />
        <rect class="s-light f-white" x="112" y="174" width="40" height="26" rx="4" />
        <rect class="s-light f-white" x="158" y="174" width="40" height="26" rx="4" />
        <rect class="s-light f-white" x="204" y="174" width="40" height="26" rx="4" />
        <rect class="s-light f-white" x="112" y="206" width="40" height="26" rx="4" />
        <rect class="s-light f-white" x="158" y="206" width="40" height="26" rx="4" />
        <rect class="s-light f-white" x="204" y="206" width="40" height="26" rx="4" />
      </g>
      <rect class="s-light f-white" x="252" y="142" width="52" height="106" rx="4" />
      <rect class="f-light" x="258" y="150" width="36" height="5" rx="2" />
      <rect class="f-light" x="258" y="161" width="28" height="5" rx="2" />
      <rect class="f-light" x="258" y="172" width="32" height="5" rx="2" />
      <rect class="f-ink" x="258" y="228" width="40" height="13" rx="3" />
      <rect class="f-light" x="196" y="268" width="24" height="40" />
      <rect class="f-mid" x="162" y="306" width="92" height="10" rx="5" />
    </g>

    <!-- Cajón portamonedas -->
    <g class="kit__drawer">
      <rect class="s-line f-white" x="98" y="316" width="220" height="44" rx="6" />
      <path class="s-light" d="M110 330h196" />
      <rect class="f-mid" x="186" y="340" width="44" height="6" rx="3" />
    </g>

    <!-- Impresora con ticket -->
    <g class="kit__printer">
      <path class="s-line f-white" d="M368 212l6 5 6-5 6 5 6-5 6 5 6-5 6 5 6-5v84h-48z" />
      <rect class="f-light" x="376" y="230" width="32" height="4" rx="2" />
      <rect class="f-light" x="376" y="240" width="24" height="4" rx="2" />
      <rect class="f-light" x="376" y="250" width="30" height="4" rx="2" />
      <rect class="f-ink" x="376" y="262" width="32" height="5" rx="2" />
      <rect class="s-line f-white" x="346" y="282" width="92" height="78" rx="10" />
      <rect class="f-ink" x="360" y="292" width="64" height="5" rx="2" />
      <circle class="f-mid" cx="420" cy="342" r="4" />
    </g>

    <!-- Comandero -->
    <g class="kit__phone">
      <rect class="s-line f-white" x="22" y="226" width="68" height="134" rx="12" />
      <rect class="f-soft" x="29" y="240" width="54" height="106" rx="4" />
      <rect class="s-light f-white" x="34" y="248" width="44" height="14" rx="3" />
      <rect class="s-light f-white" x="34" y="267" width="44" height="14" rx="3" />
      <rect class="s-light f-white" x="34" y="286" width="44" height="14" rx="3" />
      <rect class="f-ink" x="34" y="326" width="44" height="13" rx="3" />
    </g>

    <!-- Placa QR -->
    <g class="kit__plate">
      <rect class="f-ink" x="468" y="262" width="70" height="88" rx="7" />
      <rect class="f-white" x="481" y="276" width="44" height="44" rx="3" />
      <rect class="f-ink" x="486" y="281" width="12" height="12" rx="1.5" />
      <rect class="f-ink" x="508" y="281" width="12" height="12" rx="1.5" />
      <rect class="f-ink" x="486" y="303" width="12" height="12" rx="1.5" />
      <rect class="f-ink" x="508" y="303" width="5" height="5" />
      <rect class="f-ink" x="515" y="310" width="5" height="5" />
      <rect class="f-ink" x="508" y="314" width="4" height="2" />
      <rect class="f-plate-text" x="489" y="330" width="28" height="6" rx="3" />
      <rect class="f-dark" x="462" y="350" width="82" height="10" rx="3" />
    </g>

    <!-- Barra -->
    <path class="s-line" d="M8 360h584" />
    <rect class="f-soft" x="8" y="361" width="584" height="14" />
  </svg>
  <figcaption class="kit__caption">
    <span class="sr-only">Lo que puede llevar un kit:</span>
    <ul role="list" class="kit__parts">
      {parts.map((p) => (
        <li>{p}</li>
      ))}
    </ul>
  </figcaption>
</figure>

<style>
  .kit {
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }
  .kit__art {
    width: 100%;
    height: auto;
    display: block;
  }
  .kit__art .s-line {
    stroke: var(--gray-300);
    stroke-width: 1.5;
    fill: none;
  }
  .kit__art .s-light {
    stroke: var(--gray-200);
    stroke-width: 1;
  }
  .kit__art path.s-light {
    fill: none;
  }
  .kit__art .f-white {
    fill: var(--white);
  }
  .kit__art .f-soft {
    fill: var(--gray-50);
  }
  .kit__art .f-light {
    fill: var(--gray-200);
  }
  .kit__art .f-mid {
    fill: var(--gray-300);
  }
  .kit__art .f-dark {
    fill: var(--gray-700);
  }
  .kit__art .f-ink {
    fill: var(--black);
  }
  .kit__art .f-plate-text {
    fill: var(--gray-500);
  }
  .kit__art .f-ok {
    fill: var(--color-ok);
  }
  .kit__art .f-warn {
    fill: var(--color-warn);
  }
  .kit__parts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .kit__parts li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    background: var(--color-bg);
  }
</style>
