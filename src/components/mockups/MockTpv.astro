---
/**
 * TPV: ticket a la izquierda, carta a la derecha, cobro abajo. `mode` cambia el contenido según
 * el tipo de local (docs/auditoria/12 §2.1): sala (por defecto), barra, mostrador, grifos y noche.
 * El modo noche se pinta en oscuro desde `Mockup` (clase `is-night`).
 */
import type { TpvMode } from './modes';

interface Props {
  mode?: TpvMode;
}
const { mode = 'sala' } = Astro.props;

interface Line {
  q: number;
  name: string;
  sub?: string;
  /** Importe de la línea en euros */
  price: number;
}
interface Tile {
  name: string;
  price: number;
  sel?: boolean;
  off?: boolean;
}
interface ModeData {
  tabs: string[];
  /** Pestaña activa */
  on: number;
  /** Pestaña con pedidos pendientes y su número */
  badge?: [number, number];
  ticket: string;
  sub: string;
  pill: string;
  lines: Line[];
  pay: [string, string, string];
  cats: string[];
  tiles: Tile[];
}

const modes: Record<TpvMode, ModeData> = {
