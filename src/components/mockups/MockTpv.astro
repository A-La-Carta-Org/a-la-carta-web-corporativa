  noche: {
    tabs: ['Barra', 'Cuentas', 'Reservas'],
    on: 0,
    badge: [1, 4],
    ticket: 'Cuenta · Laura',
    sub: '6 personas · desde 23:40',
    pill: 'Abierta',
