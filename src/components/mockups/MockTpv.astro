    on: 0,
    ticket: 'Barra',
    sub: 'Cobro directo · sin abrir mesa',
    pill: 'Rápido',
    lines: [
      { q: 2, name: 'Caña', price: 4.8 },
      { q: 1, name: 'Tinto de verano', price: 3 },
      { q: 1, name: 'Pincho de tortilla', sub: 'caliente', price: 3.2 },
      { q: 1, name: 'Ración de bravas', price: 6.5 },
    ],
    pay: ['Efectivo', 'Tarjeta', 'Cobrar'],
    cats: ['Favoritos', 'Cervezas', 'Vinos', 'Tapas', 'Raciones', 'Cafés'],
    tiles: [
      { name: 'Caña', price: 2.4, sel: true },
      { name: 'Doble', price: 3.2 },
      { name: 'Tercio', price: 2.8 },
      { name: 'Tinto de verano', price: 3 },
      { name: 'Vermut', price: 3.5 },
      { name: 'Pincho de tortilla', price: 3.2 },
      { name: 'Bravas', price: 6.5 },
      { name: 'Boquerones', price: 8, off: true },
      { name: 'Café solo', price: 1.4 },
    ],
  },
  mostrador: {
    tabs: ['Mostrador', 'Mesas', 'Para recoger', 'Clientes'],
    on: 0,
    badge: [2, 2],
    ticket: 'Ticket 214',
    sub: 'Para llevar · Ana, 9 de 10 cafés',
