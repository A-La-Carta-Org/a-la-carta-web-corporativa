const d = modes[mode];
const eur = (n: number) => n.toFixed(2).replace('.', ',');
const total = d.lines.reduce((s, l) => s + l.price, 0);
// IVA del 10 % incluido (hostelería), solo para que la maqueta cuadre
const vat = total - total / 1.1;
---

<div class="mk mk-tpv">
  <div class="mk-topbar">
    <span class="mk-logo">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </span>
    <div class="mk-tabs">
      {d.tabs.map((t, i) => (
        <span class:list={['mk-tab', { 'is-on': i === d.on }]}>
          {t}
          {d.badge && d.badge[0] === i && <b class="mk-pill is-dark num">{d.badge[1]}</b>}
        </span>
      ))}
    </div>
    <div class="mk-right">
      <span class="mk-pill is-ok">
        <i class="mk-dot"></i> Conectado
      </span>
      <span class="mk-avatar">MR</span>
    </div>
  </div>
  <div class="mk-tpv__body">
    <aside class="mk-tpv__ticket">
      <div class="mk-tpv__head">
        <div>
          <div class="mk-strong">{d.ticket}</div>
          <div class="mk-muted">{d.sub}</div>
        </div>
        <span class="mk-pill">{d.pill}</span>
      </div>
      <div class="mk-tpv__lines">
        {d.lines.map((l) => (
          <div class="mk-row">
            <span class="num mk-muted">{l.q}</span>
            <span class="grow">
              {l.name}
              {l.sub && <span class="sub">{l.sub}</span>}
            </span>
            <span class="num">{eur(l.price)}</span>
          </div>
        ))}
      </div>
      <div class="mk-tpv__total">
        <div class="mk-row">
          <span class="grow mk-muted">Subtotal</span>
          <span class="num">{eur(total)}</span>
        </div>
        <div class="mk-row">
          <span class="grow mk-muted">IVA incl.</span>
          <span class="num mk-muted">{eur(vat)}</span>
        </div>
        <div class="mk-tpv__sum">
          <span>Total</span>
          <span class="num">{eur(total)} €</span>
        </div>
      </div>
      <div class="mk-tpv__pay">
        <span class="mk-btn is-soft">{d.pay[0]}</span>
        <span class="mk-btn is-soft">{d.pay[1]}</span>
        <span class="mk-btn is-dark">{d.pay[2]}</span>
      </div>
    </aside>
    <section class="mk-tpv__menu">
      <div class="mk-tpv__cats">
        {d.cats.map((c, i) => (
          <span class:list={['mk-tab', { 'is-on': i === 0 }]}>{c}</span>
        ))}
      </div>
      <div class="mk-grid mk-tpv__tiles">
        {d.tiles.map((t) => (
          <span class:list={['mk-tile', { 'is-sel': t.sel, 'is-off': t.off }]}>
            {t.name} <span class="num">{eur(t.price)}</span>
          </span>
        ))}
      </div>
    </section>
  </div>
</div>

<style>
  .mk-tpv__body {
    display: grid;
    grid-template-columns: 38% 1fr;
    min-height: 300px;
  }
  .mk-tpv__ticket {
    border-right: 1px solid var(--gray-200);
    display: flex;
    flex-direction: column;
    padding: 12px;
    gap: 10px;
  }
  .mk-tpv__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .mk-tpv__lines {
    flex: 1 1 auto;
  }
  .mk-tpv__total {
    border-top: 1px dashed var(--gray-300);
    padding-top: 4px;
  }
  .mk-tpv__sum {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    font-size: 13px;
    padding-top: 6px;
  }
  .mk-tpv__pay {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: 6px;
  }
  .mk-tpv__menu {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--gray-50);
  }
  .mk-tpv__cats {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
  }
  .mk-tpv__tiles {
    grid-template-columns: repeat(3, 1fr);
  }
  @container (max-width: 520px) {
    .mk-tpv__body {
      grid-template-columns: 1fr;
    }
    .mk-tpv__ticket {
      border-right: 0;
      border-bottom: 1px solid var(--gray-200);
    }
    .mk-tpv__tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
