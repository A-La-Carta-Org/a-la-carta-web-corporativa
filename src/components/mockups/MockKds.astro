const d = modes[mode];
---

<div class="mk mk-kds">
  <div class="mk-topbar">
    <span class="mk-logo">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </span>
    <div class="mk-tabs">
      {d.tabs.map((t, i) => (
        <span class:list={['mk-tab', { 'is-on': i === 0 }]}>{t}</span>
      ))}
    </div>
    <div class="mk-right">
      <span class="mk-muted">
        {d.summary} <b class="num mk-strong">{d.value}</b>
      </span>
    </div>
  </div>
  <div class="mk-kds__board">
    {d.cards.map((c) => (
      <article
        class:list={[
          'mk-kds__card',
          { 'is-late': c.state === 'late', 'is-new': c.state === 'new' },
        ]}
      >
        <header>
          <span class="mk-strong">{c.title}</span>
          <span class:list={['num', 'mk-pill', c.pill && `is-${c.pill}`]}>{c.time}</span>
        </header>
        {c.items.map((it) => (
          <div class="mk-row">
            <span class:list={['mk-check', { 'is-on': it.done }]}></span>
            <span class="grow">
              {it.text}
              {it.sub && <span class="sub">{it.sub}</span>}
            </span>
          </div>
        ))}
        <footer>
          {c.foot.btn ? (
            <span class:list={['mk-btn', 'is-block', { 'is-dark': c.foot.btn === 'dark' }]}>
              {c.foot.text}
            </span>
          ) : (
            <span class="mk-muted">{c.foot.text}</span>
          )}
        </footer>
      </article>
    ))}
  </div>
</div>

<style>
  .mk-kds__board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    padding: 10px;
    background: var(--gray-50);
    min-height: 240px;
  }
  .mk-kds__card {
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: 10px;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
  }
  .mk-kds__card.is-late {
    border-color: var(--gray-900);
  }
  .mk-kds__card header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--gray-150);
    margin-bottom: 2px;
  }
  .mk-kds__card footer {
    margin-top: auto;
    padding-top: 8px;
    font-size: 9.5px;
  }
  @container (max-width: 560px) {
    .mk-kds__board {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
