---
/**
 * Pantalla de cocina: comandas en columnas, tiempos, un retraso marcado. `mode` cambia el
 * contenido según el tipo de local (docs/auditoria/12 §2.1): restaurante (por defecto), pizzería
 * (una cola por hora de salida con el canal de cada pedido), hamburguesería y take away.
 */
import type { KdsMode } from './modes';

interface Props {
  mode?: KdsMode;
}
const { mode = 'restaurante' } = Astro.props;

interface Card {
  title: string;
  time: string;
  pill?: 'danger' | 'ok';
  state?: 'late' | 'new';
  items: { text: string; sub?: string; done?: boolean }[];
  /** Botón (oscuro o claro) o texto al pie */
  foot: { btn?: 'dark' | 'light'; text: string };
}
interface ModeData {
  tabs: string[];
  summary: string;
  value: string;
  cards: Card[];
}

