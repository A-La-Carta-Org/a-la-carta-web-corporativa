---
/**
 * Marco de dispositivo: ventana de navegador (escritorio/tablet) o móvil.
 * Sombra contenida: la única sombra «grande» de la web es para las capturas del producto.
 */
interface Props {
  kind?: 'browser' | 'phone' | 'tablet' | 'bare';
  /** Lo que se escribe en la barra de direcciones */
  url?: string;
  class?: string;
  shadow?: boolean;
}
const { kind = 'browser', url, class: className = '', shadow = true } = Astro.props;
---

<div class:list={['device', `is-${kind}`, className, { 'has-shadow': shadow }]} aria-hidden="true">
  {kind === 'browser' && (
    <div class="device__bar">
      <span class="device__dots">
        <i />
        <i />
        <i />
      </span>
      {url && <span class="device__url">{url}</span>}
    </div>
  )}
  {kind === 'phone' && <span class="device__notch" />}
  <div class="device__screen">
    <slot />
  </div>
</div>

<style>
  .device {
    position: relative;
    background: var(--white);
    border: 1px solid var(--gray-200);
    overflow: hidden;
  }
  .device.has-shadow {
    box-shadow: var(--shadow-device);
  }
  .device.is-browser,
  .device.is-tablet {
    width: 100%;
  }
  .device.is-browser {
    border-radius: var(--radius-lg);
  }
  .device.is-tablet {
    border-radius: var(--radius-xl);
    padding: 10px;
    background: var(--gray-900);
    border-color: var(--gray-900);
  }
  .device.is-tablet .device__screen {
    border-radius: calc(var(--radius-xl) - 8px);
    overflow: hidden;
    background: var(--white);
  }
  .device.is-phone {
    width: 100%;
    max-width: 17rem;
    aspect-ratio: 9 / 18.5;
    border-radius: 2.2rem;
    padding: 8px;
    background: var(--gray-900);
    border-color: var(--gray-900);
  }
  .device.is-phone .device__screen {
    height: 100%;
    border-radius: 1.75rem;
    overflow: hidden;
    background: var(--white);
  }
  .device__notch {
    position: absolute;
    top: 14px;
    left: 50%;
    translate: -50% 0;
    width: 28%;
    height: 14px;
    border-radius: 999px;
    background: var(--gray-900);
    z-index: 2;
  }
  .device.is-bare {
    border: 0;
    border-radius: var(--radius-lg);
  }
  .device__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 34px;
    padding: 0 12px;
    background: var(--gray-50);
    border-bottom: 1px solid var(--gray-200);
  }
  .device__dots {
    display: inline-flex;
    gap: 5px;
  }
  .device__dots i {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--gray-300);
  }
  .device__url {
    flex: 1 1 auto;
    max-width: 22rem;
    margin-inline: auto;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--white);
    border: 1px solid var(--gray-200);
    font-size: 10px;
    color: var(--gray-500);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .device__screen {
    position: relative;
  }
</style>
