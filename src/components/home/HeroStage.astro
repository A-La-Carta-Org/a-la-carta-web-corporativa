---
/**
 * Escenario del hero: el TPV, el comandero y, entre los dos, la comanda que se imprime en
 * cocina. En bucle cuenta «un solo sistema» sin texto: el camarero pulsa «Enviar a cocina»,
 * sale el ticket, cocina marca los platos y la comanda queda lista.
 *
 * Todo es CSS. Sin animación (o con «reducir movimiento») se ve el estado final, quieto.
 * Al hacer scroll, el escenario pasa de inclinado a plano (scroll-driven animations).
 */
import Mockup from '@/components/mockups/Mockup.astro';

const lines = [
  { qty: 1, name: 'Lubina a la sal', note: 'para 2 · sin guarnición' },
  { qty: 1, name: 'Entrecot 300 g', note: 'poco hecho' },
  { qty: 1, name: 'Risotto de boletus', note: 'sin lactosa' },
];
---

<div class="hero-stage">
  <Mockup kind="tpv" class="hero-stage__tpv" />

  <div class="hero-ticket" aria-hidden="true">
    <div class="hero-ticket__paper">
      <div class="hero-ticket__head">
        <span class="hero-ticket__where">
          <i></i>Cocina · pase
        </span>
        <span class="num">21:14</span>
      </div>
      <div class="hero-ticket__meta">Mesa 7 · 3 pax · 2.º tiempo</div>
      <ul role="list" class="hero-ticket__lines">
        {lines.map((l, i) => (
          <li style={`--i: ${i}`}>
            <span class="hero-ticket__check" />
            <span class="num">{l.qty}</span>
            <span class="hero-ticket__name">
              {l.name}
              <small>{l.note}</small>
            </span>
          </li>
        ))}
      </ul>
      <div class="hero-ticket__status">
        <span class="hero-ticket__pill is-cooking">En cocina</span>
        <span class="hero-ticket__pill is-ready">Listo para servir</span>
      </div>
    </div>
  </div>

  <Mockup kind="comandero" class="hero-stage__phone" />
</div>

<style>
  /* ── Composición ─────────────────────────────────────────────────── */
  .hero-stage {
    --loop: 10s;
    position: relative;
    max-width: 62rem;
    margin-inline: auto;
    padding-bottom: var(--space-12);
  }
  /* El TPV deja sitio al móvil: solo se solapa el margen, sin tapar platos */
  .hero-stage :global(.device.hero-stage__tpv) {
    width: calc(100% - 13.25rem);
  }
  .hero-stage :global(.device.hero-stage__phone) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 14rem;
    z-index: 3;
  }

  /* ── La comanda impresa ──────────────────────────────────────────── */
  .hero-ticket {
    position: absolute;
    right: 15.25rem;
    bottom: 3.5rem;
    width: 13.75rem;
    z-index: 2;
    rotate: -2.5deg;
    filter: drop-shadow(0 18px 24px rgb(11 11 10 / 0.18)) drop-shadow(0 2px 4px rgb(11 11 10 / 0.1));
  }
  .hero-ticket__paper {
    --zig: 6px;
    padding: 12px 14px calc(14px + var(--zig));
    background: #fffdf8;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.35;
    color: var(--gray-900);
    /* Borde inferior dentado, como el papel térmico al cortarlo */
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% /
      calc(2 * var(--zig)) 100%;
  }
  .hero-ticket__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 9.5px;
    font-weight: 600;
  }
  .hero-ticket__where {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-ticket__where i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .hero-ticket__meta {
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--gray-300);
    color: var(--gray-600);
  }
  .hero-ticket__lines {
    display: grid;
    gap: 6px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--gray-300);
  }
  .hero-ticket__lines li {
    display: grid;
    grid-template-columns: 12px 10px 1fr;
    gap: 6px;
    align-items: start;
  }
  .hero-ticket__name small {
    display: block;
    font-size: 9px;
    color: var(--gray-500);
  }
  .hero-ticket__check {
    position: relative;
    width: 12px;
    height: 12px;
    margin-top: 1px;
    border-radius: 3px;
    border: 1.2px solid var(--gray-900);
    background: var(--gray-900);
  }
  .hero-ticket__check::after {
    content: '';
    position: absolute;
    left: 3.5px;
    top: 1px;
    width: 3px;
    height: 6.5px;
    border: solid #fffdf8;
    border-width: 0 1.4px 1.4px 0;
    rotate: 45deg;
  }
  .hero-ticket__status {
    display: grid;
    padding-top: 9px;
  }
  .hero-ticket__pill {
    grid-area: 1 / 1;
    justify-self: start;
    padding: 3px 8px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 9.5px;
    font-weight: 600;
  }
  .hero-ticket__pill.is-cooking {
    background: var(--color-warn-soft);
    color: var(--color-warn);
    opacity: 0;
  }
  .hero-ticket__pill.is-ready {
    background: var(--color-ok-soft);
    color: var(--color-ok);
  }

  /* ── El bucle (solo si el usuario no pide menos movimiento) ──────── */
  @media (prefers-reduced-motion: no-preference) {
    /* 1 · El camarero pulsa «Enviar a cocina» en el móvil */
    .hero-stage :global(.hero-stage__phone .mk-cmd__foot .mk-btn) {
      animation: send-press var(--loop) var(--ease) infinite;
    }
    /* 2 · Sale el ticket por cocina */
    .hero-ticket {
      animation: ticket-life var(--loop) var(--ease) infinite;
    }
    .hero-ticket__paper {
      animation: ticket-print var(--loop) linear infinite;
    }
    /* 3 · Cocina marca los platos uno a uno */
    .hero-ticket__check {
      animation: tick var(--loop) steps(1, end) infinite;
      animation-delay: calc(var(--i) * 0.6s);
    }
    /* 4 · De «en cocina» a «listo» */
    .hero-ticket__pill.is-cooking {
      animation: pill-cooking var(--loop) steps(1, end) infinite;
    }
    .hero-ticket__pill.is-ready {
      animation: pill-ready var(--loop) steps(1, end) infinite;
    }
  }

  @keyframes send-press {
    0%,
    10% {
      scale: 1;
      background: var(--black);
      border-color: var(--black);
    }
    12% {
      scale: 0.94;
      background: var(--accent);
      border-color: var(--accent);
    }
    16%,
    20% {
      scale: 1;
      background: var(--accent);
      border-color: var(--accent);
    }
    26%,
    100% {
      scale: 1;
      background: var(--black);
      border-color: var(--black);
    }
  }
  @keyframes ticket-life {
    0%,
    14% {
      opacity: 0;
      translate: 40px 0;
    }
    18% {
      opacity: 1;
      translate: 0 0;
    }
    86% {
      opacity: 1;
      translate: 0 0;
    }
    94%,
    100% {
      opacity: 0;
      translate: 0 10px;
    }
  }
  @keyframes ticket-print {
    0%,
    16% {
      clip-path: inset(0 0 100% 0);
    }
    30%,
    100% {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes tick {
    0%,
    40% {
      background: transparent;
    }
    40.01%,
    100% {
      background: var(--gray-900);
    }
  }
  @keyframes pill-cooking {
    0%,
    28% {
      opacity: 0;
    }
    28.01%,
    62% {
      opacity: 1;
    }
    62.01%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pill-ready {
    0%,
    62% {
      opacity: 0;
    }
    62.01%,
    100% {
      opacity: 1;
    }
  }

  /* ── Inclinado → plano al hacer scroll ───────────────────────────── */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-stage {
        transform-origin: 50% 0;
        animation: stage-flatten linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70vh;
      }
    }
  }
  @keyframes stage-flatten {
    from {
      transform: perspective(1800px) rotateX(16deg) scale(0.94);
    }
    to {
      transform: none;
    }
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero-ticket {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .hero-stage {
      padding-bottom: 0;
    }
    .hero-stage :global(.device.hero-stage__tpv) {
      width: 100%;
    }
    .hero-stage :global(.device.hero-stage__phone) {
      display: none;
    }
  }
</style>
