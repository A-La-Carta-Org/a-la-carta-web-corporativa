---
/**
 * Cabecera: logo, megamenús (Soluciones, Sectores, Recursos), enlaces directos (Hardware,
 * Precios) y dos acciones: «Pruébalo» y «Solicitar demo». En móvil, menú a pantalla completa con
 * las acciones arriba y los grupos como acordeones. Modelo y contenido: docs/auditoria/02.
 */
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import QrCode from '@/components/ui/QrCode.astro';
import { mainNav, headerActions, badgeLabels } from '@/data/navigation';

interface Props {
  variant?: 'default' | 'minimal';
}
const { variant = 'default' } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const groupActive = (g: (typeof mainNav)[number]) =>
  isActive(g.href) ||
  (g.columns ?? []).some((c) => c.links.some((l) => current === l.href.split(/[?#]/)[0]));
---

<header class:list={['site-header', { 'is-minimal': variant === 'minimal' }]} data-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="alaCarta, inicio">
      <Logo size={26} />
    </a>

    {variant === 'default' && (
      <nav class="site-nav" aria-label="Principal">
        <ul role="list" class="site-nav__list">
          {mainNav.map((item) =>
            item.columns ? (
              <li
                class:list={['site-nav__item has-children', { 'is-wide': item.wide }]}
                data-dropdown
              >
                <button
                  type="button"
                  class:list={['site-nav__link', { 'is-active': groupActive(item) }]}
                  aria-expanded="false"
                  aria-controls={`mega-${item.id}`}
                  data-dropdown-toggle
                >
                  {item.label}
                  <Icon name="chevron-down" size={14} class="site-nav__chevron" />
                </button>
                <div
                  class="mega"
                  id={`mega-${item.id}`}
                  style={`--mega-w:${item.columns.length * 14 + (item.featured ? 17 : 0) + 3}rem`}
                  data-dropdown-panel
                >
                  <div class:list={['mega__body', { 'has-featured': item.featured }]}>
                    <div class="mega__cols" style={`--cols:${item.columns.length}`}>
                      {item.columns.map((col) => (
                        <div class="mega__col">
                          <p class="mega__title">{col.title}</p>
                          <ul role="list" class="mega__list">
                            {col.links.map((l) => (
                              <li>
                                <a
                                  href={l.href}
                                  class:list={[
                                    'mega__link',
                                    { 'is-active': current === l.href.split(/[?#]/)[0] },
                                    { 'has-desc': l.description },
                                  ]}
                                >
                                  {l.icon && (
                                    <span class="mega__icon">
                                      <Icon name={l.icon} size={18} />
                                    </span>
                                  )}
                                  <span class="mega__text">
                                    <span class="mega__label">
                                      {l.label}
                                      {l.badge && (
                                        <span class="chip is-status">{badgeLabels[l.badge]}</span>
                                      )}
                                    </span>
                                    {l.description && (
                                      <span class="mega__desc">{l.description}</span>
                                    )}
                                  </span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                    {item.featured && (
                      <aside class="mega__featured">
                        {item.featured.icon && (
                          <span class="mega__featured-icon">
                            <Icon name={item.featured.icon} size={20} />
                          </span>
                        )}
                        <p class="mega__featured-title">{item.featured.title}</p>
                        <p class="mega__featured-text">{item.featured.text}</p>
                        <a href={item.featured.href} class="link-arrow">
                          {item.featured.label}
                          <Icon name="arrow-right" size={14} />
                        </a>
                        {item.featured.qr && (
                          <a href={item.featured.qr.href} class="mega__qr">
                            <QrCode
                              url={item.featured.qr.url}
                              size={72}
                              label="Código QR de la carta de ejemplo"
                            />
                            <span>{item.featured.qr.label}</span>
                          </a>
                        )}
                      </aside>
                    )}
                  </div>
                  {item.footerLinks && (
                    <div class="mega__foot">
                      {item.footerLinks.map((l) => (
                        <a href={l.href} class="link-arrow">
                          {l.label}
                          <Icon name="arrow-right" size={14} />
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ) : (
              <li class="site-nav__item">
                <a
                  href={item.href}
                  class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
                >
                  {item.label}
                </a>
              </li>
            )
          )}
        </ul>
      </nav>
    )}

    <div class="site-header__actions">
      <a href={headerActions.try.href} class="btn is-ghost is-sm site-header__try">
        <Icon name="play" size={16} />
        {headerActions.try.label}
      </a>
      {variant === 'default' && (
        <a href={headerActions.demo.href} class="btn is-primary is-sm site-header__demo">
          {headerActions.demo.label}
        </a>
      )}
      {variant === 'default' && (
        <button
          type="button"
          class="site-header__burger"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="menu-movil"
          data-menu-toggle
        >
          <Icon name="menu" size={22} class="icon-open" />
          <Icon name="close" size={22} class="icon-close" />
        </button>
      )}
    </div>
  </div>

  {variant === 'default' && (
    <div class="mobile-menu" id="menu-movil" data-mobile-menu hidden>
      <div class="container">
        <div class="mobile-menu__actions">
          <a href={headerActions.try.href} class="btn is-secondary is-lg">
            <Icon name="play" size={18} />
            {headerActions.try.label}
          </a>
          <a href={headerActions.demo.href} class="btn is-primary is-lg">
            {headerActions.demo.label}
          </a>
        </div>
        <nav aria-label="Principal (móvil)">
          <ul role="list" class="mobile-menu__list">
            {mainNav.map((item) =>
              item.columns ? (
                <li>
                  <details class="mobile-menu__group" open={groupActive(item)}>
                    <summary class="mobile-menu__summary">
                      {item.label}
                      <Icon name="chevron-down" size={16} />
                    </summary>
                    <div class="mobile-menu__panel">
                      {item.columns.map((col) => (
                        <div class="mobile-menu__col">
                          <p class="mobile-menu__title">{col.title}</p>
                          <ul role="list" class="mobile-menu__sub">
                            {col.links.map((l) => (
                              <li>
                                <a href={l.href} class="mobile-menu__sublink">
                                  {l.icon && (
                                    <span class="mobile-menu__icon">
                                      <Icon name={l.icon} size={18} />
                                    </span>
                                  )}
                                  <span>{l.label}</span>
                                  {l.badge && (
                                    <span class="chip is-status">{badgeLabels[l.badge]}</span>
                                  )}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                      {item.footerLinks && (
                        <div class="mobile-menu__foot">
                          {item.footerLinks.map((l) => (
                            <a href={l.href} class="link-arrow">
                              {l.label}
                              <Icon name="arrow-right" size={14} />
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </details>
                </li>
              ) : (
                <li>
                  <a href={item.href} class="mobile-menu__link">
                    {item.label}
                    <Icon name="arrow-right" size={16} />
                  </a>
                </li>
              )
            )}
          </ul>
        </nav>
      </div>
    </div>
  )}
</header>

<script>
  // Megamenús (clic, intención de hover y teclado) y menú móvil. Sin dependencias.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const OPEN_DELAY = 120;
    const CLOSE_DELAY = 250;
    const canHover = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const dropdowns = Array.from(header.querySelectorAll<HTMLElement>('[data-dropdown]'));
    const timers = new WeakMap<HTMLElement, number>();
    const toggleOf = (d: HTMLElement) =>
      d.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');

    const setOpen = (d: HTMLElement, open: boolean) => {
      d.classList.toggle('is-open', open);
      toggleOf(d)?.setAttribute('aria-expanded', String(open));
    };
    const closeAll = (except?: HTMLElement) =>
      dropdowns.forEach((d) => d !== except && setOpen(d, false));
    const clearTimer = (d: HTMLElement) => {
      const t = timers.get(d);
      if (t) window.clearTimeout(t);
    };

    dropdowns.forEach((d) => {
      const toggle = toggleOf(d);
      toggle?.addEventListener('click', () => {
        clearTimer(d);
        const open = !d.classList.contains('is-open') || d.dataset.hoverOpened === '1';
        delete d.dataset.hoverOpened;
        closeAll(d);
        setOpen(d, open);
      });
      d.addEventListener('mouseenter', () => {
        if (!canHover()) return;
        clearTimer(d);
        timers.set(
          d,
          window.setTimeout(() => {
            if (!d.classList.contains('is-open')) d.dataset.hoverOpened = '1';
            closeAll(d);
            setOpen(d, true);
          }, OPEN_DELAY)
        );
      });
      d.addEventListener('mouseleave', () => {
        if (!canHover()) return;
        clearTimer(d);
        timers.set(
          d,
          window.setTimeout(() => {
            delete d.dataset.hoverOpened;
            setOpen(d, false);
          }, CLOSE_DELAY)
        );
      });
      // Al salir con el tabulador del panel, se cierra
      d.addEventListener('focusout', (e) => {
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (next && !d.contains(next)) setOpen(d, false);
      });
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-dropdown]')) closeAll();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = dropdowns.find((d) => d.classList.contains('is-open'));
      if (open) {
        setOpen(open, false);
        toggleOf(open)?.focus();
      }
      if (mobile && !mobile.hidden) {
        closeMobile();
        burger?.focus();
      }
    });

    const burger = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobile = header.querySelector<HTMLElement>('[data-mobile-menu]');
    // Abrir y cerrar con transición: `hidden` se quita antes de animar y se pone al terminar
    let hideTimer = 0;
    const setMobile = (open: boolean) => {
      if (!mobile || !burger) return;
      window.clearTimeout(hideTimer);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        mobile.hidden = false;
        requestAnimationFrame(() => requestAnimationFrame(() => mobile.classList.add('is-open')));
      } else {
        mobile.classList.remove('is-open');
        const ms = parseFloat(getComputedStyle(mobile).transitionDuration) * 1000 || 0;
        hideTimer = window.setTimeout(() => (mobile.hidden = true), ms + 40);
      }
    };
    const closeMobile = () => {
      if (mobile && !mobile.hidden) setMobile(false);
    };
    burger?.addEventListener('click', () => {
      if (!mobile) return;
      setMobile(!mobile.classList.contains('is-open'));
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 1024) closeMobile();
    });

    // Sombra sutil al hacer scroll
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--color-border);
  }
  /* Sin `.container`: la cabecera ocupa todo el ancho con un margen lateral pequeño */
  .site-header__inner {
    height: var(--header-h);
    padding-inline: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .site-header__logo {
    display: inline-flex;
    flex: 0 0 auto;
  }
  .site-header__logo:hover {
    text-decoration: none;
  }

  /* ── Navegación de escritorio ─────────────────────────────────── */
  .site-nav {
    flex: 1 1 auto;
    display: flex;
    justify-content: center;
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .site-nav__item {
    position: relative;
  }
  /* El megamenú ancho se ancla a la cabecera, no al botón */
  .site-nav__item.is-wide {
    position: static;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .site-nav__link:hover,
  .site-nav__link.is-active,
  .has-children.is-open .site-nav__link {
    background: var(--color-bg-muted);
    color: var(--color-text-strong);
    text-decoration: none;
  }
  .site-nav__link :global(.site-nav__chevron) {
    transition: rotate var(--dur-fast) var(--ease);
    color: var(--color-text-muted);
  }
  .has-children.is-open :global(.site-nav__chevron) {
    rotate: 180deg;
  }

  /* ── Megamenú ─────────────────────────────────────────────────── */
  /* Solo `transform` (no `translate`): el minificador fusiona ambas y perdería el centrado */
  .mega {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    width: min(var(--mega-w), calc(100vw - 2 * var(--gutter)));
    background: var(--white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -8px) scale(0.985);
    transform-origin: 50% 0;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      visibility 0s linear var(--dur);
  }
  .is-wide .mega {
    top: calc(100% - 4px);
    width: min(calc(var(--container-wide) - 2 * var(--gutter)), calc(100vw - 2 * var(--gutter)));
  }
  .has-children.is-open .mega {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0) scale(1);
    transition-delay: 0s;
  }
  /* Las columnas y el destacado llegan escalonados */
  .mega__col,
  .mega__featured {
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }
  .has-children.is-open :is(.mega__col, .mega__featured) {
    opacity: 1;
    translate: 0 0;
  }
  .has-children.is-open .mega__col:nth-child(2) {
    transition-delay: 40ms;
  }
  .has-children.is-open .mega__col:nth-child(3) {
    transition-delay: 80ms;
  }
  .has-children.is-open .mega__col:nth-child(4) {
    transition-delay: 120ms;
  }
  .has-children.is-open .mega__featured {
    transition-delay: 140ms;
  }
  .mega__body {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
  }
  .mega__body.has-featured {
    grid-template-columns: minmax(0, 1fr) 14rem;
  }
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-6);
  }
  .is-wide .mega__cols {
    gap: var(--space-4);
  }
  .mega__col {
    min-width: 0;
  }
  .mega__title {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 0 var(--space-2) var(--space-3);
  }
  .mega__list {
    display: grid;
    gap: 2px;
  }
  .mega__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    transition: background-color var(--dur-fast) var(--ease);
  }
  .mega__link.has-desc {
    align-items: flex-start;
  }
  .mega__link:hover,
  .mega__link.is-active {
    background: var(--color-bg-muted);
    text-decoration: none;
  }
  .mega__icon {
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-bg-muted);
    color: var(--color-text-strong);
    transition: background-color var(--dur-fast) var(--ease);
  }
  .mega__link:hover .mega__icon,
  .mega__link.is-active .mega__icon {
    background: var(--white);
  }
  .mega__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .mega__label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-strong);
    line-height: var(--leading-snug);
  }
  .mega__desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }
  .mega__featured {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    align-self: start;
    padding: var(--space-5);
    background: var(--gray-50);
    border-radius: var(--radius-lg);
  }
  .mega__featured-icon {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--white);
    border: 1px solid var(--color-border);
  }
  .mega__featured-title {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-strong);
    line-height: var(--leading-snug);
  }
  .mega__featured-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .mega__featured .link-arrow {
    font-size: var(--text-sm);
  }
  .mega__qr {
    margin-top: var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    width: 100%;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }
  .mega__qr:hover {
    text-decoration: none;
    color: var(--color-text-strong);
  }
  .mega__qr :global(.qr-code) {
    padding: 6px;
    background: var(--white);
    border-radius: var(--radius-sm);
    box-sizing: content-box;
  }
  .mega__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  /* ── Acciones ─────────────────────────────────────────────────── */
  .site-header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .site-header__try {
    gap: var(--space-2);
  }
  .site-header__burger {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
  }
  .site-header__burger:hover {
    background: var(--color-bg-muted);
  }
  .site-header__burger :global(.icon-close) {
    display: none;
  }
  .site-header__burger[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .site-header__burger[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  /* ── Menú móvil ───────────────────────────────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: var(--z-menu);
    background: var(--white);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block: var(--space-4) var(--space-12);
    border-top: 1px solid var(--color-border);
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }
  .mobile-menu.is-open {
    opacity: 1;
    translate: 0 0;
  }
  /* Los grupos del menú llegan escalonados */
  .mobile-menu :is(.mobile-menu__actions, .mobile-menu__list > li, .mobile-menu__foot) {
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }
  .mobile-menu.is-open :is(.mobile-menu__actions, .mobile-menu__list > li, .mobile-menu__foot) {
    opacity: 1;
    translate: 0 0;
  }
  .mobile-menu.is-open .mobile-menu__list > li:nth-child(1) {
    transition-delay: 30ms;
  }
  .mobile-menu.is-open .mobile-menu__list > li:nth-child(2) {
    transition-delay: 60ms;
  }
  .mobile-menu.is-open .mobile-menu__list > li:nth-child(3) {
    transition-delay: 90ms;
  }
  .mobile-menu.is-open .mobile-menu__list > li:nth-child(4) {
    transition-delay: 120ms;
  }
  .mobile-menu.is-open .mobile-menu__list > li:nth-child(n + 5),
  .mobile-menu.is-open .mobile-menu__foot {
    transition-delay: 150ms;
  }
  .mobile-menu__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
