---
import Logo from '@/components/ui/Logo.astro';
import { footerNav, legalNav } from '@/data/navigation';
import { CONTACT_EMAIL, SITE_TAGLINE } from '@/data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label="alaCarta, inicio">
          <Logo size={26} />
        </a>
        <p class="muted">{SITE_TAGLINE}.</p>
        <a href={`mailto:${CONTACT_EMAIL}`} class="site-footer__mail">
          {CONTACT_EMAIL}
        </a>
      </div>
      <nav class="site-footer__nav" aria-label="Pie de página">
        {footerNav.map((group) => (
          <div class="site-footer__group">
            <h2 class="site-footer__title">{group.title}</h2>
            <ul role="list">
              {group.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="site-footer__bottom">
      <p class="muted">© {year} alaCarta. Todos los derechos reservados.</p>
      <ul role="list" class="site-footer__legal">
        {legalNav.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-16) var(--space-10);
    font-size: var(--text-sm);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1.2fr 2.4fr;
    gap: var(--space-12);
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .site-footer__brand p {
    max-width: 18rem;
  }
  .site-footer__mail {
    color: var(--color-text-strong);
    font-weight: var(--weight-medium);
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .site-footer__title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .site-footer__group ul {
    display: grid;
    gap: var(--space-2);
  }
  .site-footer__group a {
    color: var(--color-text);
  }
  .site-footer__group a:hover {
    color: var(--color-text-strong);
  }
  .site-footer__bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: var(--text-xs);
  }
  .site-footer__legal {
    display: flex;
    gap: var(--space-5);
  }
  .site-footer__legal a {
    color: var(--color-text-muted);
  }
  @media (max-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .site-footer__nav {
      grid-template-columns: 1fr;
    }
  }
</style>
